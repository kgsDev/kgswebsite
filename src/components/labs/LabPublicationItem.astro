---
// src/components/labs/LabPublicationItem.astro
// One publication row on a lab's Publications page. `featured` adds the badge and
// a heavier brand-blue rule.
interface Props {
  pub: any;
  pubsDbUrl: string;
  featured?: boolean;
}

const { pub, pubsDbUrl, featured = false } = Astro.props;

function formatAuthors(authorJunctions: any) {
  if (!Array.isArray(authorJunctions) || authorJunctions.length === 0) return '';

  const names = authorJunctions
    .map((j: any) => j.authors_id)
    .filter((a: any) => a && (a.first_name || a.last_name))
    .map((a: any) =>
      [a.prefix, a.first_name, a.middle_name, a.last_name, a.suffix].filter(Boolean).join(' ').trim()
    )
    .filter((n: string) => n.length > 0);

  if (names.length === 0) return '';
  if (names.length === 1) return names[0];
  if (names.length === 2) return `${names[0]} and ${names[1]}`;
  return `${names.slice(0, -1).join(', ')}, and ${names[names.length - 1]}`;
}

const pubUrl = pub.url_webpage || pub.url_download || null;
const authors = formatAuthors(pub.author_id);
---

<div class={`pub-row ${featured ? 'pub-row--featured' : ''} pl-6 pb-6 border-b border-gray-100 last:border-b-0`}>
  <div class="flex gap-4">
    {pub.cover && (
      <div class="flex-shrink-0">
        <img
          src={`${pubsDbUrl}/assets/${pub.cover}?width=200&quality=80`}
          alt={`Cover for ${pub.title}`}
          class="w-24 h-32 object-cover object-top rounded shadow-sm"
          loading="lazy"
        />
      </div>
    )}

    <div class="flex-1 min-w-0">
      <div class="mb-3">
        {featured && (
          <span class="pub-badge">
            <i class="fas fa-star" aria-hidden="true"></i> Featured
          </span>
        )}

        <h3 class="text-lg font-semibold lab-primary-text mb-2">
          {pubUrl ? (
            <a href={pubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
              {pub.title}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ) : (
            pub.title
          )}
        </h3>

        {authors && (
          <p class="text-gray-700 mb-2">
            <strong>KGS-Affiliated Authors:</strong> {authors}
          </p>
        )}

        {pub.publication_year && (
          <div class="text-sm text-gray-600">
            <strong>Year:</strong> {pub.publication_year}
          </div>
        )}
      </div>

      <div class="flex flex-wrap gap-3 text-sm">
        {pub.url_webpage && (
          <a
            href={pub.url_webpage}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
            aria-label={`View publication "${pub.title}" on its webpage (opens in a new tab)`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            View Publication
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}

        {pub.url_download && (
          <a
            href={pub.url_download}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
            aria-label={`Download PDF for publication "${pub.title}" (opens in a new tab)`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Download PDF
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .pub-row {
    border-left: 4px solid #3b82f6;
  }
  .pub-row--featured {
    border-left: 5px solid #0033A0;
  }
  .pub-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fff;
    background: #0033A0;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.5rem;
  }
</style>