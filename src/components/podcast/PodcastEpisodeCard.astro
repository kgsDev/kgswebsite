---
// src/components/podcast/PodcastEpisodeCard.astro
// Compact horizontal card: episode art, title, "Ep. · date · duration", 2-line summary.
// The whole card is clickable via a stretched title link (no nested anchors).
import { formatEpisodeDate, formatDuration, stripHtml } from '../../lib/api_podcast';

interface Props {
  episode: any;
}

const { episode: ep } = Astro.props;

const meta = [
  ep.episode_number != null ? `Ep. ${ep.episode_number}` : null,
  formatEpisodeDate(ep.pub_date),
  formatDuration(ep.duration),
].filter(Boolean).join(' · ');

const blurb = stripHtml(ep.summary || ep.description);
---

<article class="episode-card">
  {ep.image_url ? (
    <img
      src={ep.image_url}
      alt=""
      width="96"
      height="96"
      loading="lazy"
      decoding="async"
      class="episode-art"
    />
  ) : (
    <div class="episode-art episode-art--fallback" aria-hidden="true">
      <i class="fas fa-podcast"></i>
    </div>
  )}
  <div class="episode-body">
    <h4 class="episode-title">
      <a href={`/podcast/${ep.slug}`} class="stretched-link">{ep.title}</a>
    </h4>
    {meta && <p class="episode-meta">{meta}</p>}
    {blurb && <p class="episode-blurb">{blurb}</p>}
  </div>
</article>

<style>
  .episode-card {
    position: relative;
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    padding: 0.75rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .episode-card:hover,
  .episode-card:focus-within {
    border-color: #0033A0;
    box-shadow: 0 4px 12px rgba(0, 51, 160, 0.12);
  }
  .episode-art {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 0.375rem;
    background: #f3f4f6;
  }
  .episode-art--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0033A0;
    font-size: 2rem;
  }
  .episode-body {
    min-width: 0;
  }
  .episode-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }
  .episode-title a {
    color: #0033A0;
  }
  .episode-title a:focus-visible {
    outline: none; /* the card's :focus-within ring shows focus instead */
  }
  .episode-card:has(a:focus-visible) {
    outline: 3px solid #0033A0;
    outline-offset: 2px;
  }
  .stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .episode-meta {
    font-size: 0.8rem;
    color: #4b5563;
    margin: 0.25rem 0 0;
  }
  .episode-blurb {
    font-size: 0.875rem;
    color: #374151;
    margin: 0.375rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 480px) {
    .episode-art {
      width: 72px;
      height: 72px;
    }
  }
</style>