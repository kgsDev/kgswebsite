---
// src/components/research/ResearchPresentations.astro
import { fetchTeamPresentations } from '../../lib/api_research';

interface Props {
  teamId: number;
  title?: string;
  showInSidebar?: boolean;
  limit?: number;
}

const { 
  teamId, 
  title = "Recent Presentations",
  showInSidebar = false,
  limit = showInSidebar ? 3 : null
} = Astro.props;

// Fetch presentations for this research team
const presentations = await fetchTeamPresentations(teamId, { 
  yearGroup: false,
  limit: limit 
});

// Helper function to format date
function formatDate(dateString) {
  if (!dateString) return null;
  
  const date = new Date(dateString);
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}
---

{presentations.length > 0 && (
  <div class={showInSidebar ? "sidebar-presentations" : "main-presentations"}>
    <style>
      .main-presentations {
        margin: 2rem 0;
        background: #f8f9fa;
        padding: 2rem;
        border-radius: 0.5rem;
      }

      .main-presentations h3 {
        color: #0033A0;
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
      }

      .main-presentations h3 i {
        margin-right: 0.75rem;
      }

      .sidebar-presentations {
        /* Styles already defined in parent page */
      }

      .pres-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .pres-item {
        background: white;
        border: 1px solid #e5e7eb;
        border-left: 4px solid #0033A0;
        border-radius: 0.5rem;
        padding: 1.25rem;
        transition: box-shadow 0.2s;
      }

      .pres-item:hover {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }

      .pres-title h4 {
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.5rem;
        line-height: 1.3;
        font-size: 1.125rem;
      }

      .pres-citation {
        font-size: 0.875rem;
        color: #4b5563;
        margin-bottom: 0.75rem;
        line-height: 1.6;
        background: #f9fafb;
        padding: 0.75rem;
        border-radius: 0.375rem;
      }

      .pres-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 0.75rem;
      }

      .pres-meta-item {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }

      .pres-meta-item i {
        color: #0033A0;
        width: 14px;
      }

      .pres-year {
        font-weight: 600;
        color: #4b5563;
      }

      .pres-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .pres-link {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.375rem 0.75rem;
        background: #0033A0;
        color: white;
        border-radius: 0.25rem;
        font-size: 0.875rem;
        text-decoration: none;
        transition: background 0.2s;
      }

      .pres-link:hover {
        background: #002d8f;
      }

      .pres-link i {
        font-size: 0.75rem;
      }

      .pres-link.video {
        background: #dc2626;
      }

      .pres-link.video:hover {
        background: #b91c1c;
      }

      /* Sidebar-specific styles */
      .sidebar-presentations .pres-item {
        padding: 1rem;
      }

      .sidebar-presentations .pres-title h4 {
        font-size: 0.9375rem;
      }

      .sidebar-presentations .pres-citation {
        font-size: 0.8125rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .sidebar-presentations .pres-meta {
        font-size: 0.8125rem;
        gap: 0.5rem;
      }

      /* Compact sidebar version */
      .pres-list-compact {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .pres-list-compact .pres-item {
        padding: 1rem;
      }

      .pres-list-compact .pres-title h4 {
        font-size: 0.9375rem;
        margin-bottom: 0.25rem;
      }
    </style>

    {!showInSidebar && (
      <h3>
        <i class="fas fa-presentation"></i>
        {title}
      </h3>
    )}

    <div class={showInSidebar ? "pres-list-compact" : "pres-list"}>
      {presentations.map((pres) => (
        <article class="pres-item">
          <div class="pres-title">
            <h4>{pres.title}</h4>
          </div>
          
          {pres.citation && (
            <div class="pres-citation" set:html={pres.citation} />
          )}
          
          {(pres.year || pres.venue || pres.location ) && (
            <div class="pres-meta">
              {pres.year && (
                <div class="pres-meta-item">
                  <i class="fas fa-calendar"></i>
                  <span class="pres-year">{pres.year}</span>
                </div>
              )}
              
              {pres.venue && (
                <div class="pres-meta-item">
                  <i class="fas fa-building"></i>
                  <span>{pres.venue}</span>
                </div>
              )}
              
              {pres.location && (
                <div class="pres-meta-item">
                  <i class="fas fa-map-marker-alt"></i>
                  <span>{pres.location}</span>
                </div>
              )}
            
            </div>
          )}
          
          {(pres.slides_url || pres.video_url || pres.doi || pres.paper_url) && (
            <div class="pres-links">
              {pres.slides_url && (
                <a href={pres.slides_url} target="_blank" rel="noopener noreferrer" class="pres-link">
                  <i class="fas fa-file-powerpoint"></i>
                  Slides
                </a>
              )}
              
              {pres.video_url && (
                <a href={pres.video_url} target="_blank" rel="noopener noreferrer" class="pres-link video">
                  <i class="fas fa-play-circle"></i>
                  Video
                </a>
              )}
              
              {pres.doi && (
                <a href={`https://doi.org/${pres.doi}`} target="_blank" rel="noopener noreferrer" class="pres-link">
                  <i class="fas fa-link"></i>
                  DOI
                </a>
              )}
              
              {pres.paper_url && (
                <a href={pres.paper_url} target="_blank" rel="noopener noreferrer" class="pres-link">
                  <i class="fas fa-file-alt"></i>
                  Paper
                </a>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
)}