---
// src/components/research/RelatedLinkCard.astro
// Generic card for story maps, interactive maps, and educational pages.
// Image on top (16:9), title, optional 3-line description. Whole card clickable.

interface Props {
  title: string;
  url: string;
  image?: string | null;
  description?: string | null;
  external?: boolean;
}

const { title, url, image, description, external = false } = Astro.props;
---

<article class="link-card">
  {image && (
    <img src={image} alt="" loading="lazy" decoding="async" class="link-card-img" />
  )}
  <div class="link-card-body">
    <h4 class="link-card-title">
      <a
        href={url}
        class="stretched-link"
        {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {title}
        {external && (
          <>
            <i class="fas fa-arrow-up-right-from-square link-card-ext" aria-hidden="true"></i>
            <span class="sr-only"> (opens in a new tab)</span>
          </>
        )}
      </a>
    </h4>
    {description && <p class="link-card-desc">{description}</p>}
  </div>
</article>

<style>
  .link-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    overflow: hidden;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .link-card:hover,
  .link-card:focus-within {
    border-color: #0033A0;
    box-shadow: 0 4px 12px rgba(0, 51, 160, 0.12);
  }
  .link-card:has(a:focus-visible) {
    outline: 3px solid #0033A0;
    outline-offset: 2px;
  }
  .link-card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #f3f4f6;
  }
  .link-card-body {
    padding: 0.75rem 0.875rem 0.875rem;
  }
  .link-card-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }
  .link-card-title a {
    color: #0033A0;
  }
  .link-card-title a:focus-visible {
    outline: none;
  }
  .link-card-ext {
    font-size: 0.7rem;
    margin-left: 0.3rem;
  }
  .stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .link-card-desc {
    font-size: 0.875rem;
    color: #374151;
    margin: 0.375rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>