---
// src/components/research/RelatedContent.astro
// "Related Content" section for research team pages:
//   podcast episodes → story maps → interactive maps → educational pages → news.
// Each group hides itself when empty; the whole section hides when every group is empty.
import PodcastEpisodeCard from '../podcast/PodcastEpisodeCard.astro';
import RelatedLinkCard from './RelatedLinkCard.astro';
import NewsCard from '../news/NewsCard.astro';
import { fetchTeamEpisodes } from '../../lib/api_podcast';
import { fetchTeamNews } from '../../lib/api_news';

// Shape for story maps, interactive maps, and educational pages. Whatever fetchers get
// built for those collections should normalize their rows to this.
export interface RelatedLink {
  title: string;
  url: string;
  image?: string | null;
  description?: string | null;
  external?: boolean;
}

interface Props {
  team: { id: number | string; name: string; slug: string };
  podcastLimit?: number;
  newsLimit?: number;
  storyMaps?: RelatedLink[];
  interactiveMaps?: RelatedLink[];
  educationalPages?: RelatedLink[];
}

const {
  team,
  podcastLimit = 20,
  newsLimit = 5,
  storyMaps = [],
  interactiveMaps = [],
  educationalPages = [],
} = Astro.props;

// Fetch in parallel; a failure in one source just empties that group.
const [episodes, news] = await Promise.all([
  fetchTeamEpisodes(team?.id, { limit: podcastLimit }).catch(() => []),
  team?.id ? fetchTeamNews(team.id, { limit: newsLimit }).catch(() => []) : [],
]);

const linkGroups = [
  { key: 'story-maps', title: 'Story Maps', icon: 'fa-book-atlas', items: storyMaps },
  { key: 'interactive-maps', title: 'Interactive Maps', icon: 'fa-map-location-dot', items: interactiveMaps },
  { key: 'education', title: 'Learn More', icon: 'fa-graduation-cap', items: educationalPages },
];

// News order: category "event" first, then "our_collection", then everything else.
// Labels are what show as subheadings; edit freely.
const NEWS_GROUP_ORDER = [
  { key: 'event', label: 'Events' },
  { key: 'our_collection', label: 'From Our Collection' },
];
const OTHER_NEWS_LABEL = 'News';

// Reads the category whether it comes back as a string, an array (multi-select),
// or a related object ({ value } / { slug } / { name }).
function categoriesOf(item: any): string[] {
  const raw = item?.category;
  const list = Array.isArray(raw) ? raw : raw != null ? [raw] : [];
  return list
    .map((c) => (typeof c === 'object' && c ? c.value ?? c.slug ?? c.name : c))
    .filter(Boolean)
    .map((c) => String(c).toLowerCase());
}

// Each article lands in the first group it matches; the rest go to "other".
// Original fetch order (newest first) is kept within each group.
const newsBuckets = new Map(NEWS_GROUP_ORDER.map((g) => [g.key, [] as any[]]));
const otherNews: any[] = [];
for (const item of news) {
  const cats = categoriesOf(item);
  const match = NEWS_GROUP_ORDER.find((g) => cats.includes(g.key));
  (match ? newsBuckets.get(match.key)! : otherNews).push(item);
}
const newsGroups = [
  ...NEWS_GROUP_ORDER.map((g) => ({ ...g, items: newsBuckets.get(g.key)! })),
  { key: 'other', label: OTHER_NEWS_LABEL, items: otherNews },
].filter((g) => g.items.length > 0);

// Only label the subgroups when there's more than one; a lone group needs no subheading.
const showNewsSubheadings = newsGroups.length > 1;

const hasAny =
  episodes.length > 0 ||
  news.length > 0 ||
  linkGroups.some((g) => g.items.length > 0);

const headingId = `related-content-${team?.slug || team?.id}`;
---

{hasAny && (
  <section class="related-content" aria-labelledby={headingId}>
    <h2 id={headingId} class="related-heading">
      <i class="fas fa-layer-group" aria-hidden="true"></i>
      Related Content
    </h2>

    {episodes.length > 0 && (
      <div class="related-group">
        <div class="related-group-header">
          <h3><i class="fas fa-podcast" aria-hidden="true"></i> The Big Blue Rock Pod</h3>
          <a href="/podcast" class="related-more">
            All episodes <i class="fas fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
        <div class="related-grid related-grid--episodes">
          {episodes.map((ep) => <PodcastEpisodeCard episode={ep} />)}
        </div>
      </div>
    )}

    {linkGroups.map((group) => group.items.length > 0 && (
      <div class="related-group">
        <div class="related-group-header">
          <h3><i class={`fas ${group.icon}`} aria-hidden="true"></i> {group.title}</h3>
        </div>
        <div class="related-grid related-grid--links">
          {group.items.map((item) => <RelatedLinkCard {...item} />)}
        </div>
      </div>
    ))}

    {news.length > 0 && (
      <div class="related-group">
        <div class="related-group-header">
          <h3><i class="fas fa-newspaper" aria-hidden="true"></i> {`Latest ${team.name} News`}</h3>
          <a href={`/news?team=${team.slug}`} class="related-more">
            View All News <i class="fas fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
        {newsGroups.map((group) => (
          <div class="related-news-group">
            {showNewsSubheadings && <h4 class="related-news-subhead">{group.label}</h4>}
            <div class="space-y-6 related-news">
              {group.items.map((newsItem) => <NewsCard article={newsItem} team={team} />)}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
)}

<style>
  .related-content {
    margin: 2.5rem 0;
    padding-top: 1.5rem;
    border-top: 2px solid #e5e7eb;
  }
  .related-heading {
    color: #0033A0;
    font-size: 1.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .related-group + .related-group {
    margin-top: 2rem;
  }
  .related-group-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .related-group-header h3 {
    color: #0033A0;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .related-more {
    font-size: 0.875rem;
    font-weight: 600;
    color: #0033A0;
    white-space: nowrap;
  }
  .related-more:hover,
  .related-more:focus-visible {
    text-decoration: underline;
  }
  .related-grid {
    display: grid;
    gap: 1rem;
  }
  .related-grid--episodes {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .related-grid--links {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .related-news {
    margin: 0 1rem;
  }
  .related-news-group + .related-news-group {
    margin-top: 1.5rem;
  }
  .related-news-subhead {
    font-size: 1rem;
    font-weight: 700;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 1rem 0.75rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid #e5e7eb;
  }
  @media (max-width: 768px) {
    .related-news {
      margin: 0;
    }
  }
</style>