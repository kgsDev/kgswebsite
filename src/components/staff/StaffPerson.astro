---
// src/components/staff/StaffPerson.astro
// A staff member with photo (or initials), name, title, and primary team.
import { staffGroup } from '../../lib/staff_helpers';
const { person, size = 'md', showTitle = true } = Astro.props;
const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL;

const px = size === 'sm' ? 36 : 56;
// Request ~2x display size at the photos' native 3:4 ratio; CSS crops to a circle
const photoUrl = person.photo
  ? `${directusUrl}assets/${person.photo}?quality=80&width=${px * 2}&height=${Math.round(px * 2 * 4 / 3)}&fit=cover`
  : null;

const name = [person.first_name, person.last_name].filter(Boolean).join(' ');
const initials = `${person.first_name?.[0] ?? ''}${person.last_name?.[0] ?? ''}`.toUpperCase();
const group = staffGroup(person);
const groupIcon = group?.kind === 'team' ? 'fa-users' : 'fa-building';
const Tag = person.slug ? 'a' : 'div';
---

<Tag href={person.slug ? `/staff/${person.slug}` : undefined} class={`sp sp-${size}`}>
  {photoUrl ? (
    <img src={photoUrl} alt="" width={px} height={px} loading="lazy" class="sp-photo" />
  ) : (
    <span class="sp-photo sp-initials" aria-hidden="true">{initials}</span>
  )}
  <span class="sp-text">
    <span class="sp-name">{name}</span>
    {showTitle && person.working_title && (
      <span class="sp-title">{person.working_title}</span>
    )}
    {group && (
      <span class="sp-team">
        <i class={`fas ${groupIcon}`} aria-hidden="true"></i>
        {group.name}
      </span>
    )}
  </span>
</Tag>

<style>
  .sp {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms, background-color 150ms, box-shadow 150ms;
  }
  a.sp:hover {
    border-color: #93c5fd;
    background: #f8fbff;
    box-shadow: 0 2px 6px rgba(30, 58, 138, 0.06);
  }
  a.sp:hover .sp-name { color: #1d4ed8; text-decoration: underline; }
  a.sp:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }

  .sp-photo {
    flex: 0 0 auto;
    border-radius: 9999px;
    object-fit: cover;
    object-position: 50% 20%; /* favor faces in portrait shots */
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px #dbeafe;
  }
  .sp-md .sp-photo { width: 3.5rem; height: 3.5rem; }
  .sp-sm .sp-photo { width: 2.25rem; height: 2.25rem; }

  .sp-initials {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #dbeafe;
    color: #1e3a8a;
    font-weight: 700;
  }
  .sp-md .sp-initials { font-size: 1.1rem; }
  .sp-sm .sp-initials { font-size: 0.8rem; }

  .sp-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  .sp-name { font-weight: 600; color: #1e3a8a; }
  .sp-md .sp-name { font-size: 1rem; }
  .sp-sm .sp-name { font-size: 0.875rem; }

  .sp-title { font-size: 0.85rem; color: #4b5563; }
  .sp-team {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.15rem;
    font-size: 0.8rem;
    color: #6b7280;
  }
  .sp-team i { font-size: 0.7rem; color: #9ca3af; }
</style>