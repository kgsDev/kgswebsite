---
// src/pages/staff/index.astro
export const prerender = false; // Enable SSR for this page
import StaffLayout from '../../layouts/StaffLayout.astro';
import StaffList from '../../components/staff/StaffList.astro';
import { fetchStaffByDepartment, fetchAllDepartments } from '../../lib/api_staff';

const LEADERSHIP = 'State Geologist and Directors';

// Fetch all staff grouped by department (now includes leadership section)
const staffByDepartment = await fetchStaffByDepartment();

// Extract unique teams from all staff members for the team filter
const allTeams = new Set();

// Process staff and extract team information
Object.values(staffByDepartment).flat().forEach(member => {
  if (member.team && Array.isArray(member.team)) {
    member.team.forEach(team => {
      // Look for all possible name properties based on your API response
      const teamName = team.name || team.team_name || team.description || team.title;
      if (teamName) {
        allTeams.add(teamName);
      }
    });
    
    // Create a teamNames string for filtering - try all possible name properties
    member.teamNames = member.team
      .map(t => t.name || t.team_name || t.description || t.title || '')
      .filter(Boolean)
      .join('|');
      
    // Debug team names
    if (member.team.length > 0 && !member.teamNames) {
      console.log(`Warning: ${member.first_name} ${member.last_name} has teams but no team names. Team object keys:`, 
        member.team.map(t => Object.keys(t)));
    }
  } else {
    member.teamNames = '';
  }
});

const uniqueTeams = Array.from(allTeams).sort();
console.log(`Found ${uniqueTeams.length} unique teams`);

// Get list of departments for filter (excluding leadership section)
const departmentNames = Object.keys(staffByDepartment).filter(dept => dept !== LEADERSHIP);

// Directors are grouped under LEADERSHIP, not their home division. Map each
// division to its director(s) via department_id.name so we can also render
// them at the top of their division (shown only when that division is filtered).
const directorsByDivision = {};
(staffByDepartment[LEADERSHIP] || []).forEach(member => {
  const division = member.department_id?.name;
  if (division && departmentNames.includes(division)) {
    (directorsByDivision[division] ||= []).push(member);
  }
});
---

<StaffLayout 
  title="Staff Directory"
  description="Contact information for Kentucky Geological Survey staff and affiliates.">
      
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2 text-blue-900">KGS Staff and Affiliates Directory</h1>
    <p class="text-gray-600">Contact information for Kentucky Geological Survey staff and affiliated faculty and students.</p>
  </div>

  <!-- Search and Filter Controls -->
  <div class="bg-white p-4 rounded-lg shadow mb-8">
    <div class="grid md:grid-cols-4 gap-4">
      <!-- Search Input -->
      <div class="md:col-span-2">
        <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search</label>
        <input 
          type="text" 
          id="search" 
          placeholder="Search by name or expertise..." 
          class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>
      
      <!-- Department Filter -->
      <div>
        <label for="department" class="block text-sm font-medium text-gray-700 mb-1">Filter by Division</label>
        <select 
          id="department" 
          class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Divisions</option>
          {departmentNames.map((dept) => (
            <option value={dept}>{dept}</option>
          ))}
        </select>
      </div>
      
      <!-- Team Filter -->
      <div>
        <label for="team" class="block text-sm font-medium text-gray-700 mb-1">Filter by Team</label>
        <select 
          id="team" 
          class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Teams</option>
          {uniqueTeams.length > 0 ? (
            uniqueTeams.map((team) => (
              <option value={team}>{team}</option>
            ))
          ) : (
            <option disabled>No teams available</option>
          )}
        </select>
      </div>
    </div>
    
    <div class="mt-4 grid md:grid-cols-4 gap-4">
      <!-- Sort Direction -->
      <div>
        <label for="sort" class="block text-sm font-medium text-gray-700 mb-1">Sort By</label>
        <select 
          id="sort" 
          class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="name">Name (A-Z)</option>
          <option value="name-desc">Name (Z-A)</option>
        </select>
      </div>
      
      <!-- Active Filters Display -->
      <div class="md:col-span-3 flex items-end">
        <div id="active-filters" class="flex flex-wrap gap-2">
          <!-- Active filters will be added here by JavaScript -->
        </div>
      </div>
    </div>
  </div>

  <!-- Department Sections -->
  <div id="staff-container" class="space-y-12">
{Object.entries(staffByDepartment).map(([department, staff]) => (
  <div class="department-section" data-department={department}>
    {department === LEADERSHIP ? (
      <>
        <div class="mb-6">
          <h2 class="text-2xl font-bold mb-2 pb-2 border-b-2 border-blue-500 text-blue-900">
            <svg xmlns="http://www.w3.org/2000/svg" style="width: 1.5rem; height: 1.5rem;" class="inline mr-2 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            {department}
          </h2>
          <p class="text-gray-600 text-sm mb-4">Leadership of the Kentucky Geological Survey</p>
        </div>
        <StaffList staff={staff} />
      </>
    ) : (
      <>
        <h2 class="text-2xl font-bold mb-4 pb-2 border-b-2 border-blue-500 text-blue-900">{department}</h2>

        {/* Division director(s): duplicated from the leadership section, hidden
            until this division is selected in the filter */}
        {directorsByDivision[department]?.length > 0 && (
          <div class="division-director-block hidden mb-8" data-division-director>
            <h3 class="text-xl font-semibold mb-3 text-blue-800 flex items-center">
              <i class="fas fa-star mr-2" aria-hidden="true"></i>
              {directorsByDivision[department].length > 1 ? 'Division Directors' : 'Division Director'}
            </h3>
            <StaffList staff={directorsByDivision[department]} />
          </div>
        )}

        {department === 'Geoscience Research' ? (
          (() => {
            const teamLeads = staff.filter(member => 
              member.team_leader && Array.isArray(member.team_leader) && member.team_leader.length > 0
            );
            const researchers = staff.filter(member => 
              !member.team_leader || !Array.isArray(member.team_leader) || member.team_leader.length === 0
            );
            
            return (
              <>
                {teamLeads.length > 0 && (
                  <div class="mb-8">
                    <h3 class="text-xl font-semibold mb-3 text-blue-800 flex items-center">
                      <i class="fas fa-compass mr-2" aria-hidden="true"></i>
                      Research Team Leads
                    </h3>
                    <StaffList staff={teamLeads} />
                  </div>
                )}
                
                {researchers.length > 0 && (
                  <div>
                    <h3 class="text-xl font-semibold mb-3 text-blue-800 flex items-center">
                      <i class="fas fa-flask mr-2" aria-hidden="true"></i>
                      Researchers
                    </h3>
                    <StaffList staff={researchers} />
                  </div>
                )}
              </>
            );
          })()
        ) : (
          <StaffList staff={staff} />
        )}
      </>
    )}
  </div>
))}
  </div>

  <!-- No Results Message (hidden by default) -->
  <div id="no-results" class="hidden py-8 text-center">
    <h3 class="text-xl font-medium text-gray-700">No staff members found</h3>
    <p class="text-gray-500 mt-2">Try adjusting your search criteria</p>
  </div>
</StaffLayout>

<script>
  // Client-side search and filtering functionality
  // Supports URL params:
  //   ?division=geoscience-research   (also accepts ?department=)
  //   ?team=karst                     (slug or exact name, case-insensitive)
  //   ?q=groundwater                  (search text)
  //   ?sort=name-desc                 (name | name-desc)
  document.addEventListener('DOMContentLoaded', () => {
    const LEADERSHIP = 'State Geologist and Directors';
    const DIRECTOR_BLOCK = '[data-division-director]';

    const searchInput = document.getElementById('search');
    const departmentSelect = document.getElementById('department');
    const teamSelect = document.getElementById('team');
    const sortSelect = document.getElementById('sort');
    const staffContainer = document.getElementById('staff-container');
    const noResults = document.getElementById('no-results');
    const departmentSections = document.querySelectorAll('.department-section');
    const activeFilters = document.getElementById('active-filters');

    // ---------- URL parameter helpers ----------

    // "Geoscience Research" -> "geoscience-research", "Oil & Gas" -> "oil-and-gas"
    const slugify = (s) =>
      (s || '')
        .toString()
        .toLowerCase()
        .trim()
        .replace(/&/g, 'and')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');

    // Find the <option> whose value matches a URL value (by slug, so case,
    // spaces, and punctuation don't matter). Returns '' if nothing matches.
    function matchOption(select, raw) {
      if (!raw) return '';
      const target = slugify(raw);
      const match = Array.from(select.options).find(
        (o) => o.value && !o.disabled && slugify(o.value) === target
      );
      return match ? match.value : '';
    }

    // Read the URL and set the form controls to match
    function applyUrlParams() {
      const params = new URLSearchParams(window.location.search);
      departmentSelect.value = matchOption(
        departmentSelect,
        params.get('division') ?? params.get('department')
      );
      teamSelect.value = matchOption(teamSelect, params.get('team'));
      searchInput.value = params.get('q') ?? '';
      sortSelect.value = params.get('sort') === 'name-desc' ? 'name-desc' : 'name';
    }

    // Write the current control values back to the URL (without reloading
    // or adding history entries). Unrelated params (e.g. utm_*) are kept.
    function updateUrl() {
      const params = new URLSearchParams(window.location.search);
      const setOrDelete = (key, value) => (value ? params.set(key, value) : params.delete(key));

      params.delete('department'); // normalize legacy alias to ?division=
      setOrDelete('division', departmentSelect.value ? slugify(departmentSelect.value) : '');
      setOrDelete('team', teamSelect.value ? slugify(teamSelect.value) : '');
      setOrDelete('q', searchInput.value.trim());
      setOrDelete('sort', sortSelect.value !== 'name' ? sortSelect.value : '');

      const qs = params.toString();
      const newUrl = window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash;
      const currentUrl = window.location.pathname + window.location.search + window.location.hash;
      if (newUrl !== currentUrl) {
        history.replaceState(history.state, '', newUrl);
      }
    }

    // ---------- Active filter pills ----------

    // Full class strings (not built dynamically) so Tailwind keeps them
    const PILL_STYLES = {
      blue: {
        pill: 'px-2 py-1 rounded-full bg-blue-100 text-blue-800 text-xs flex items-center',
        button: 'ml-1 text-blue-500 hover:text-blue-700',
      },
      gray: {
        pill: 'px-2 py-1 rounded-full bg-gray-100 text-gray-800 text-xs flex items-center',
        button: 'ml-1 text-gray-500 hover:text-gray-700',
      },
    };

    const CLOSE_ICON = `
      <svg xmlns="http://www.w3.org/2000/svg" style="width: 0.875rem; height: 0.875rem;" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>`;

    // Builds a pill with textContent (never innerHTML) for the user-supplied
    // value — the search text can come from the URL, so it must not be
    // parsed as HTML.
    function addPill(label, value, style, onRemove) {
      const pill = document.createElement('div');
      pill.className = style.pill;

      const text = document.createElement('span');
      text.textContent = `${label}: ${value}`;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = style.button;
      button.setAttribute('aria-label', `Remove ${label.toLowerCase()} filter`);
      button.innerHTML = CLOSE_ICON; // static markup only
      button.addEventListener('click', () => {
        onRemove();
        filterStaff();
      });

      pill.append(text, button);
      activeFilters.appendChild(pill);
    }

    function updateActiveFilters() {
      activeFilters.innerHTML = '';

      if (departmentSelect.value) {
        addPill('Division', departmentSelect.value, PILL_STYLES.blue, () => {
          departmentSelect.value = '';
        });
      }

      if (teamSelect.value) {
        addPill('Team', teamSelect.value, PILL_STYLES.blue, () => {
          teamSelect.value = '';
        });
      }

      if (searchInput.value) {
        addPill('Search', searchInput.value, PILL_STYLES.gray, () => {
          searchInput.value = '';
        });
      }
    }
    
    // ---------- Filtering ----------

    // Show/hide each card by search + team; returns how many are visible
    function filterCards(cards, searchTerm, selectedTeam) {
      let visible = 0;
      cards.forEach(card => {
        const name = card.getAttribute('data-name')?.toLowerCase() || '';
        const title = card.getAttribute('data-title')?.toLowerCase() || '';
        const expertise = card.getAttribute('data-expertise')?.toLowerCase() || '';
        const teams = card.getAttribute('data-teams')?.split('|') || [];

        const matchesSearch =
          searchTerm === '' ||
          name.includes(searchTerm) ||
          title.includes(searchTerm) ||
          expertise.includes(searchTerm);

        const matchesTeam =
          selectedTeam === '' ||
          teams.some(t => t.toLowerCase() === selectedTeam.toLowerCase());

        if (matchesSearch && matchesTeam) {
          card.classList.remove('hidden');
          visible++;
        } else {
          card.classList.add('hidden');
        }
      });
      return visible;
    }

    function filterStaff() {
      const searchTerm = searchInput.value.toLowerCase();
      const selectedDepartment = departmentSelect.value;
      const selectedTeam = teamSelect.value;
      let hasVisibleStaff = false;
      
      // Update active filters display and keep the URL in sync
      updateActiveFilters();
      updateUrl();
      
      departmentSections.forEach(section => {
        const department = section.getAttribute('data-department');
        let visibleCount = 0;

        if (department === LEADERSHIP) {
          // Leadership shows when no division is selected. With a division
          // selected, its director appears inside that division instead.
          if (selectedDepartment) {
            section.classList.add('hidden');
            return;
          }
          visibleCount = filterCards(
            section.querySelectorAll('.staff-card-container'),
            searchTerm,
            selectedTeam
          );
        } else {
          if (selectedDepartment && selectedDepartment !== department) {
            section.classList.add('hidden');
            return;
          }

          // Director block: only when this division is the active filter
          const directorBlock = section.querySelector(DIRECTOR_BLOCK);
          if (directorBlock) {
            const showDirectors = selectedDepartment === department;
            const directorCount = showDirectors
              ? filterCards(directorBlock.querySelectorAll('.staff-card-container'), searchTerm, selectedTeam)
              : 0;
            directorBlock.classList.toggle('hidden', directorCount === 0);
            visibleCount += directorCount;
          }

          // Regular staff cards (everything outside the director block)
          const staffCards = Array.from(section.querySelectorAll('.staff-card-container'))
            .filter(card => !card.closest(DIRECTOR_BLOCK));
          visibleCount += filterCards(staffCards, searchTerm, selectedTeam);
        }

        section.classList.toggle('hidden', visibleCount === 0);
        if (visibleCount > 0) hasVisibleStaff = true;
      });
      
      // Toggle no results message
      noResults.classList.toggle('hidden', hasVisibleStaff);
      staffContainer.classList.toggle('hidden', !hasVisibleStaff);
    }
    
    // ---------- Sorting ----------

    function sortStaff() {
      const sortBy = sortSelect.value;
      updateUrl();
      
      departmentSections.forEach(section => {
        // Don't sort the leadership section - it has its own hierarchy
        if (section.getAttribute('data-department') === LEADERSHIP) return;

        // Sort every card grid in the section (e.g. both "Team Leads" and
        // "Researchers"), but leave the director block alone
        const grids = Array.from(section.querySelectorAll('div[class*="grid"]'))
          .filter(grid => !grid.closest(DIRECTOR_BLOCK));

        grids.forEach(staffList => {
          const staffCards = Array.from(staffList.children);

          staffCards.sort((a, b) => {
            const aName = a.getAttribute('data-name') || '';
            const bName = b.getAttribute('data-name') || '';
            const aTitle = a.getAttribute('data-title') || '';
            const bTitle = b.getAttribute('data-title') || '';

            if (sortBy === 'name-desc') return bName.localeCompare(aName);
            if (sortBy === 'title') return aTitle.localeCompare(bTitle);
            return aName.localeCompare(bName);
          });

          // appendChild moves existing nodes, so this reorders in place
          staffCards.forEach(card => staffList.appendChild(card));
        });
      });
    }
    
    // ---------- Wire up ----------

    searchInput.addEventListener('input', filterStaff);
    departmentSelect.addEventListener('change', filterStaff);
    teamSelect.addEventListener('change', filterStaff);
    sortSelect.addEventListener('change', sortStaff);
    
    // Initialize from the URL, then filter (and sort only if non-default,
    // so the server's original order is kept otherwise)
    applyUrlParams();
    filterStaff();
    if (sortSelect.value !== 'name') {
      sortStaff();
    }
  });
</script>