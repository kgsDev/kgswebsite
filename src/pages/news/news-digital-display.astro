---
// src/pages/news/digital-display.astro
export const prerender = false;
import DigitalDisplayLayout from '../../layouts/DigitalDisplayLayout.astro';
import { fetchRecentNews } from '../../lib/api_news';
import { fetchFacebookPosts } from '../../lib/api_facebook';

const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL;

// Fetch 6 recent news items and up to 4 Facebook posts in parallel
const [{ articles }, fbFeed] = await Promise.all([
  fetchRecentNews(6, 1),
  fetchFacebookPosts(4),
]);
const fbPosts = fbFeed.posts;

const formatDate = (dateString) => {
  if (!dateString) return '';
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const formatDateRange = (startDate, endDate) => {
  if (!startDate) return '';
  
  const start = new Date(startDate);
  const startMonth = start.toLocaleDateString('en-US', { month: 'long' });
  const startDay = start.getDate();
  const startYear = start.getFullYear();
  
  if (!endDate || startDate === endDate || 
      (new Date(endDate)).toDateString() === start.toDateString()) {
    return `${startMonth} ${startDay}, ${startYear}`;
  }
  
  const end = new Date(endDate);
  const endMonth = end.toLocaleDateString('en-US', { month: 'long' });
  const endDay = end.getDate();
  const endYear = end.getFullYear();
  
  if (startMonth === endMonth && startYear === endYear) {
    return `${startMonth} ${startDay}–${endDay}, ${startYear}`;
  }
  
  if (startYear === endYear) {
    return `${startMonth} ${startDay} – ${endMonth} ${endDay}, ${startYear}`;
  }
  
  return `${startMonth} ${startDay}, ${startYear} – ${endMonth} ${endDay}, ${endYear}`;
};

const isEventPast = (endDate) => {
  if (!endDate) return false;
  const end = new Date(endDate);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return end < today;
};

const mediaTypeLabels: Record<string, string> = {
  tv_interview:    "TV Interview",
  tv_news:         "TV News",
  online_article:  "Online Article",
  newspaper:       "Newspaper",
  radio_interview: "Radio Interview",
  podcast:         "Podcast",
  radio_news:      "Radio News",
  documentary:     "Documentary",
};

const mediaTypeIcons: Record<string, string> = {
  tv_interview:    "fa-tv",
  tv_news:         "fa-tv",
  online_article:  "fa-globe",
  newspaper:       "fa-newspaper",
  radio_interview: "fa-microphone",
  podcast:         "fa-podcast",
  radio_news:      "fa-radio",
  documentary:     "fa-film",
};

const getCategoryInfo = (article) => {
  if (article.category === "press") {
    return {
      label: "Press Release",
      color: "bg-blue-100 text-blue-800",
      icon: "fa-newspaper"
    };
  } else if (article.category === "research") {
    return {
      label: "Research",
      color: "bg-green-100 text-green-800",
      icon: "fa-flask"
    };
  } else if (article.category === "our_collection") {
    return {
      label: "From Our Collection",
      color: "bg-yellow-100 text-yellow-800",
      icon: "fa-box-archive"
    };
  } else if (article.category === "event") {
    return {
      label: isEventPast(article.event_end) ? "Past Event" : "Upcoming Event",
      color: isEventPast(article.event_end) ? "bg-gray-100 text-gray-700" : "bg-purple-100 text-purple-800",
      icon: "fa-calendar"
    };
  } else if (article.category === "media") {
    const mediaLabel = article.media_type
      ? (mediaTypeLabels[article.media_type] || article.media_type.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()))
      : "KGS in the Media";
    return {
      label: mediaLabel,
      color: "bg-orange-100 text-orange-800",
      icon: article.media_type ? (mediaTypeIcons[article.media_type] || "fa-broadcast-tower") : "fa-broadcast-tower"
    };
  } else {
    return {
      label: "News",
      color: "bg-gray-100 text-gray-800",
      icon: "fa-bullhorn"
    };
  }
};
---

<DigitalDisplayLayout 
  title="Digital News Display"
  headerTitle="Latest News & Announcements"
  description="Kentucky Geological Survey recent news and announcements."
  noticeStyle="both"
  qrCodeUrl="/assets/qr-news.png"
  qrCodeLabel="Scan for Full<br>News Articles"
  bannerText=""
  watermarkText="NEWS DISPLAY"
  watermarkSubtext="Scan QR Code for Full Articles">

  <div class="digital-news-display">
    
    <div class="grid grid-cols-3 gap-5" style="margin-top: 5rem;">
      
      {/* Facebook Feed - Left column (rendered server-side from the Graph API) */}
      <div class="facebook-feed-column">
        <h2 class="text-3xl font-bold text-blue-900 mb-6 flex items-center">
          <i class="fab fa-facebook text-blue-600 mr-3"></i>
          Facebook Updates<br />
          Follow Us @KGSNews
        </h2>

        <div class="fb-posts">
          {fbPosts.length > 0 ? (
            fbPosts.map((post) => (
              <article class="fb-post bg-white border-2 border-gray-200 rounded-lg overflow-hidden shadow-md">
                {post.full_picture && (
                  <img
                    src={post.full_picture}
                    alt=""
                    class="fb-post-image"
                    referrerpolicy="no-referrer"
                  />
                )}
                <div class="p-5">
                  <div class="mb-3 flex items-center text-gray-600 text-base">
                    <i class="fab fa-facebook mr-2 text-blue-600"></i>
                    <span class="font-medium">{formatDate(post.created_time)}</span>
                  </div>
                  {post.message && (
                    <p class="fb-post-text text-gray-800 text-lg leading-relaxed">
                      {post.message}
                    </p>
                  )}
                </div>
              </article>
            ))
          ) : (
            <div class="fb-fallback bg-white border-2 border-gray-200 rounded-lg p-8 text-center shadow-md">
              <i class="fab fa-facebook text-6xl text-blue-600 mb-4"></i>
              <p class="text-2xl font-bold text-blue-900">facebook.com/KGSNews</p>
              <p class="text-gray-600 text-lg mt-2">Follow us for the latest updates</p>
            </div>
          )}
        </div>
      </div>

      {/* News Articles - Right 2 columns */}
      <div class="col-span-2 grid grid-cols-2 gap-8">
        {articles.map((article) => {
          const displayImage = article.tile_image || article.main_image;
          const categoryInfo = getCategoryInfo(article);
          const displayDate = article.category === "event" && article.event_date 
            ? formatDateRange(article.event_date, article.event_end)
            : formatDate(article.publication_date);
          
          return (
            <div class="news-card-full bg-white border-2 border-gray-200 rounded-lg overflow-hidden shadow-md">
              <div class="flex flex-col h-full">
                {/* Image Section - Top */}
                <div class="news-image-container-full flex-shrink-0">
                  {displayImage ? (
                    <img 
                      src={`${directusUrl}assets/${displayImage}?width=800&height=533&quality=85&fit=cover`} 
                      alt={article.title}
                      class="news-image-full"
                    />
                  ) : (
                    <div class={`news-image-placeholder-full ${article.category === 'media' ? 'media-placeholder' : ''}`}>
                      <i class={`fas ${categoryInfo.icon} text-5xl ${article.category === 'media' ? 'text-orange-300' : 'text-gray-400'}`}></i>
                    </div>
                  )}
                  
                  {/* Category Badge Overlay */}
                  <div class="absolute top-3 left-3">
                    <span class={`inline-flex items-center px-3 py-1.5 rounded-md text-sm font-semibold shadow-lg ${categoryInfo.color}`}>
                      <i class={`fas ${categoryInfo.icon} mr-2`}></i>
                      {categoryInfo.label}
                    </span>
                  </div>
                  
                  {/* Past Event Badge */}
                  {article.category === "event" && isEventPast(article.event_end) && (
                    <div class="absolute top-3 right-3 bg-gray-700 text-white text-sm font-bold px-3 py-1.5 rounded-md shadow-lg">
                      PAST
                    </div>
                  )}

                  {/* External link indicator for media items */}
                  {article.category === "media" && (
                    <div class="absolute top-3 right-3 bg-orange-800 text-white text-sm font-bold px-3 py-1.5 rounded-md shadow-lg">
                      <i class="fas fa-external-link-alt mr-1"></i>KGS in the Media
                    </div>
                  )}
                </div>
                
                {/* Content Section - Bottom */}
                <div class="p-5 flex flex-col flex-grow">
                  {/* Date */}
                  <div class="mb-3 flex items-center text-gray-600 text-base">
                    <i class="fas fa-calendar mr-2 text-blue-500"></i>
                    <span class="font-medium">{displayDate}</span>
                  </div>

                  {/* Media outlet name */}
                  {article.category === "media" && article.media_name && (
                    <div class="mb-3 flex items-center text-orange-700 text-sm font-semibold">
                      <i class="fas fa-building mr-2 text-orange-500"></i>
                      {article.media_name}
                    </div>
                  )}
                  
                  {/* Title */}
                  <h3 class="font-bold text-blue-900 text-lg mb-3 leading-tight">
                    {article.title}
                  </h3>
                  
                  {/* Excerpt */}
                  {article.excerpt && (
                    <p class="text-gray-700 text-base leading-relaxed mb-4 flex-grow">
                      {article.excerpt}
                    </p>
                  )}
                  
                  {/* Additional Details Section */}
                  <div class="mt-auto space-y-3">
                    {/* Event Location for Events */}
                    {article.category === "event" && article.event_location && (
                      <div class="flex items-start text-sm text-gray-600 bg-purple-50 p-3 rounded-md">
                        <i class="fas fa-map-marker-alt mr-2 mt-0.5 flex-shrink-0 text-purple-600"></i>
                        <span>{article.event_location}</span>
                      </div>
                    )}
                    
                    {/* Event Time for Events */}
                    {article.category === "event" && article.event_time && (
                      <div class="flex items-center text-sm text-gray-600 bg-purple-50 p-3 rounded-md">
                        <i class="fas fa-clock mr-2 text-purple-600"></i>
                        <span>{article.event_time}</span>
                      </div>
                    )}

                    {/* Media URL for media items */}
                    {article.category === "media" && article.media_url && (
                      <div class="flex items-center text-sm text-orange-700 bg-orange-50 p-3 rounded-md">
                        <i class="fas fa-external-link-alt mr-2 text-orange-500 flex-shrink-0"></i>
                        <span class="truncate">{article.media_url.replace(/^https?:\/\//, '').split('/')[0]}</span>
                      </div>
                    )}
                    
                    {/* Tags */}
                    {article.tags && article.tags.length > 0 && (
                      <div class="pt-3 border-t border-gray-200">
                        <div class="flex flex-wrap gap-2">
                          {article.tags.map((tag) => (
                            <span class="inline-block px-3 py-1.5 rounded-full text-sm bg-gray-100 text-gray-700 font-medium">
                              #{tag}
                            </span>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
    
    {articles.length === 0 && (
      <div class="text-center py-20 bg-white rounded-lg border-2 border-gray-200">
        <i class="fas fa-newspaper text-6xl text-gray-300 mb-4"></i>
        <p class="text-gray-500 text-lg">No recent news articles available</p>
      </div>
    )}
  </div>
</DigitalDisplayLayout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  .digital-news-display {
    max-width: 2200px;
    margin: 0 auto;
    padding: 1.5rem 4rem;
  }
  
  .news-card-full {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .news-card-full:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  /* 3:2 aspect ratio for images */
  .news-image-container-full {
    position: relative;
    width: 100%;
    padding-top: 66.67%;
    overflow: hidden;
    background: #f3f4f6;
  }
  
  .news-image-full {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .news-image-placeholder-full {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
  }

  .news-image-placeholder-full.media-placeholder {
    background: linear-gradient(135deg, #fff7ed 0%, #fed7aa 100%);
  }
  
  /* Facebook Feed Styling */
  .facebook-feed-column {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .fb-posts {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .fb-post-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: #f3f4f6;
  }

  /* Keep Facebook's line breaks, cap long posts so they don't push others off-screen */
  .fb-post-text {
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 8;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>