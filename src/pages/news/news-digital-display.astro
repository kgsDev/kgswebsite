---
// src/pages/news/digital-display.astro
export const prerender = false;
import DigitalDisplayLayout from '../../layouts/DigitalDisplayLayout.astro';
import StaffPerson from '../../components/staff/StaffPerson.astro';
import { fetchEvents, fetchRecentNews } from '../../lib/api_news';
import { getEventTypes } from '../../lib/eventTypes';
import { getArticleStaff } from '../../lib/api_staff';

const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL;

const EVENTS_MAX = 6;   // two rows of three across the top
const NEWS_MAX = 6;
const MAX_PEOPLE = 3;

const [eventsRes, newsRes] = await Promise.all([
  fetchEvents(EVENTS_MAX, 1, true),
  fetchRecentNews(NEWS_MAX + EVENTS_MAX, 1), // only need NEWS_MAX, but fetchRecentNews returns events too, so fetch more and filter out the events
  //fetchRecentNews(NEWS_MAX, 1)
]);

const upcomingEvents = eventsRes.articles;
const eventIds = new Set(upcomingEvents.map((e) => e.id));
const articles = newsRes.articles.filter((a) => !eventIds.has(a.id)).slice(0, NEWS_MAX); // only need NEWS_MAX, but fetchRecentNews returns events too, so filter out the events
//const articles = newsRes.articles

// Date-only strings ('2026-11-12') as local dates, avoiding the UTC off-by-one
const parseDate = (s) => {
  if (!s) return null;
  const str = String(s);
  if (/^\d{4}-\d{2}-\d{2}$/.test(str)) {
    const [y, m, d] = str.split('-').map(Number);
    return new Date(y, m - 1, d);
  }
  return new Date(str);
};

const MONTHS_SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const eventBadge = (ev) => {
  const d = parseDate(ev.event_date) ?? parseDate(ev.event_end);
  return d ? { mon: MONTHS_SHORT[d.getMonth()], day: d.getDate() } : null;
};

const eventCols = ['grid-cols-1', 'grid-cols-2', 'grid-cols-3'][Math.min(upcomingEvents.length, 3) - 1] || 'grid-cols-3';


const formatDate = (dateString) => {
  if (!dateString) return '';
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const formatDateRange = (startDate, endDate) => {
  if (!startDate) return '';
  
  const start = new Date(startDate);
  const startMonth = start.toLocaleDateString('en-US', { month: 'long' });
  const startDay = start.getDate();
  const startYear = start.getFullYear();
  
  if (!endDate || startDate === endDate || 
      (new Date(endDate)).toDateString() === start.toDateString()) {
    return `${startMonth} ${startDay}, ${startYear}`;
  }
  
  const end = new Date(endDate);
  const endMonth = end.toLocaleDateString('en-US', { month: 'long' });
  const endDay = end.getDate();
  const endYear = end.getFullYear();
  
  if (startMonth === endMonth && startYear === endYear) {
    return `${startMonth} ${startDay}–${endDay}, ${startYear}`;
  }
  
  if (startYear === endYear) {
    return `${startMonth} ${startDay} – ${endMonth} ${endDay}, ${startYear}`;
  }
  
  return `${startMonth} ${startDay}, ${startYear} – ${endMonth} ${endDay}, ${endYear}`;
};

const isEventPast = (endDate) => {
  if (!endDate) return false;
  const end = new Date(endDate);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return end < today;
};

const mediaTypeLabels: Record<string, string> = {
  tv_interview:    "TV Interview",
  tv_news:         "TV News",
  online_article:  "Online Article",
  newspaper:       "Newspaper",
  radio_interview: "Radio Interview",
  podcast:         "Podcast",
  radio_news:      "Radio News",
  documentary:     "Documentary",
};

const mediaTypeIcons: Record<string, string> = {
  tv_interview:    "fa-tv",
  tv_news:         "fa-tv",
  online_article:  "fa-globe",
  newspaper:       "fa-newspaper",
  radio_interview: "fa-microphone",
  podcast:         "fa-podcast",
  radio_news:      "fa-radio",
  documentary:     "fa-film",
};

const getCategoryInfo = (article) => {
  if (article.category === "press") {
    return {
      label: "Press Release",
      color: "bg-blue-100 text-blue-800",
      icon: "fa-newspaper"
    };
  } else if (article.category === "research") {
    return {
      label: "Research",
      color: "bg-green-100 text-green-800",
      icon: "fa-flask"
    };
  } else if (article.category === "our_collection") {
    return {
      label: "From Our Collection",
      color: "bg-yellow-100 text-yellow-800",
      icon: "fa-box-archive"
    };
  } else if (article.category === "event") {
    return {
      label: isEventPast(article.event_end) ? "Past Event" : "Upcoming Event",
      color: isEventPast(article.event_end) ? "bg-gray-100 text-gray-700" : "bg-purple-100 text-purple-800",
      icon: "fa-calendar"
    };
  } else if (article.category === "media") {
    const mediaLabel = article.media_type
      ? (mediaTypeLabels[article.media_type] || article.media_type.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()))
      : "KGS in the Media";
    return {
      label: mediaLabel,
      color: "bg-orange-100 text-orange-800",
      icon: article.media_type ? (mediaTypeIcons[article.media_type] || "fa-broadcast-tower") : "fa-broadcast-tower"
    };
  } else {
    return {
      label: "News",
      color: "bg-gray-100 text-gray-800",
      icon: "fa-bullhorn"
    };
  }
};
---

<DigitalDisplayLayout 
  title="Digital News Display"
  headerTitle="Latest News & Announcements"
  description="Kentucky Geological Survey recent news and announcements."
  noticeStyle="both"
  qrCodeUrl="/assets/qr-news.png"
  qrCodeLabel="Scan for Full<br>News Articles"
  bannerText=""
  watermarkText="NEWS DISPLAY"
  watermarkSubtext="Scan QR Code for Full Articles">

  <div class="digital-news-display">

    {/* Upcoming events — full width, below the header. Wrapper always renders for the refresh script. */}
    <section id="events-strip" aria-label="Upcoming events" style="margin-top: 1rem;">
      {upcomingEvents.length > 0 && (
        <div class="events-band">
          <h2 class="display-section-title">
            <i class="fas fa-calendar-days" aria-hidden="true"></i>
            Upcoming Events
          </h2>
          <ul class={`events-list grid ${eventCols}`} role="list">
            {upcomingEvents.map((ev) => {
              const badge = eventBadge(ev);
              const types = getEventTypes(ev);
              return (
                <li class="event-row">
                  {badge && (
                    <div class="event-date">
                      <span class="event-mon">{badge.mon}</span>
                      <span class="event-day">{badge.day}</span>
                    </div>
                  )}
                  <div class="event-body">
                    <h3 class="event-title">{ev.title}</h3>
                    <p class="event-meta">
                      {types.map((t) => (
                        <span class="event-type">
                          <i class={`fas ${t.icon} ${t.iconColor}`} aria-hidden="true"></i>
                          {t.label}
                        </span>
                      ))}
                      <span>{formatDateRange(ev.event_date, ev.event_end)}</span>
                      {ev.event_location && (
                        <span>
                          <i class="fas fa-map-marker-alt event-meta-icon" aria-hidden="true"></i>
                          {ev.event_location}
                        </span>
                      )}
                    </p>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </section>

    {/* Social + news — top margin reduced since the events band now sits above */}
    <div class="grid grid-cols-3 gap-5" style="margin-top: 2.5rem;">
      
      {/* Social Feed - Left column (Curator.io: Facebook, Instagram, Threads) */}
      <div class="social-feed-column">
        <h2 class="text-3xl font-bold text-blue-900 mb-6">
          Social Updates
          <span class="social-icons">
            <i class="fab fa-facebook text-blue-600"></i>
            <i class="fab fa-instagram text-pink-600"></i>
            <i class="fab fa-threads text-gray-900"></i>
          </span>
          <span class="block text-xl font-semibold text-gray-700 mt-2">Follow Us @KGSNews</span>
        </h2>

        <div class="social-feed-container">
          <div id="curator-feed-default-feed-layout">
            <a href="https://curator.io" target="_blank" class="crt-logo crt-tag">Powered by Curator.io</a>
          </div>
        </div>

        <script is:inline type="text/javascript">
          /* curator-feed-default-feed-layout */
          (function(){
            var i,e,d=document,s="script";i=d.createElement("script");i.async=1;i.charset="UTF-8";
            i.src="https://cdn.curator.io/published/c80b8a60-67c3-4196-8e47-66813787b135.js";
            e=d.getElementsByTagName(s)[0];e.parentNode.insertBefore(i, e);
          })();
        </script>
      </div>

      {/* News Articles - Right 2 columns */}
      <div id="news-grid" class="col-span-2 grid grid-cols-2 gap-8">
        {articles.map((article) => {
          const displayImage = article.tile_image || article.main_image;
          const categoryInfo = getCategoryInfo(article);
          const people = getArticleStaff(article);
          const displayDate = article.category === "event" && article.event_date 
            ? formatDateRange(article.event_date, article.event_end)
            : formatDate(article.publication_date);
          
          return (
            <div class="news-card-full bg-white border-2 border-gray-200 rounded-lg overflow-hidden shadow-md">
              <div class="flex flex-col h-full">
                {/* Image Section - Top */}
                <div class="news-image-container-full flex-shrink-0">
                  {displayImage ? (
                    <img 
                      src={`${directusUrl}assets/${displayImage}?width=800&height=533&quality=85&fit=cover`} 
                      alt={article.title}
                      class="news-image-full"
                    />
                  ) : (
                    <div class={`news-image-placeholder-full ${article.category === 'media' ? 'media-placeholder' : ''}`}>
                      <i class={`fas ${categoryInfo.icon} text-5xl ${article.category === 'media' ? 'text-orange-300' : 'text-gray-400'}`}></i>
                    </div>
                  )}
                  
                  {/* Category Badge Overlay */}
                  <div class="absolute top-3 left-3">
                    <span class={`inline-flex items-center px-3 py-1.5 rounded-md text-sm font-semibold shadow-lg ${categoryInfo.color}`}>
                      <i class={`fas ${categoryInfo.icon} mr-2`}></i>
                      {categoryInfo.label}
                    </span>
                  </div>
                  
                  {/* Past Event Badge */}
                  {article.category === "event" && isEventPast(article.event_end) && (
                    <div class="absolute top-3 right-3 bg-gray-700 text-white text-sm font-bold px-3 py-1.5 rounded-md shadow-lg">
                      PAST
                    </div>
                  )}

                  {/* External link indicator for media items */}
                  {article.category === "media" && (
                    <div class="absolute top-3 right-3 bg-orange-800 text-white text-sm font-bold px-3 py-1.5 rounded-md shadow-lg">
                      <i class="fas fa-external-link-alt mr-1"></i>KGS in the Media
                    </div>
                  )}
                </div>
                
                {/* Content Section - Bottom */}
                <div class="p-5 flex flex-col flex-grow">
                  {/* Date */}
                  <div class="mb-3 flex items-center text-gray-600 text-base">
                    <i class="fas fa-calendar mr-2 text-blue-500"></i>
                    <span class="font-medium">{displayDate}</span>
                  </div>

                  {/* Media outlet name */}
                  {article.category === "media" && article.media_name && (
                    <div class="mb-3 flex items-center text-orange-700 text-sm font-semibold">
                      <i class="fas fa-building mr-2 text-orange-500"></i>
                      {article.media_name}
                    </div>
                  )}
                  
                  {/* Title */}
                  <h3 class="font-bold text-blue-900 text-lg mb-3 leading-tight">
                    {article.title}
                  </h3>
                  
                  {/* Excerpt */}
                  {article.excerpt && (
                    <p class="text-gray-700 text-base leading-relaxed mb-4 flex-grow">
                      {article.excerpt}
                    </p>
                  )}
                  
                  {/* People involved: photo, name, job title, team/department */}
                  {people.length > 0 && (
                    <div class="people-list mb-4">
                      {people.slice(0, MAX_PEOPLE).map((p) => (
                        <StaffPerson person={p} size="lg" link={false} />
                      ))}
                      {people.length > MAX_PEOPLE && (
                        <p class="people-more">+{people.length - MAX_PEOPLE} more</p>
                      )}
                    </div>
                  )}

                  {/* Additional Details Section */}
                  <div class="mt-auto space-y-3">
                    {/* Event Location for Events */}
                    {article.category === "event" && article.event_location && (
                      <div class="flex items-start text-sm text-gray-600 bg-purple-50 p-3 rounded-md">
                        <i class="fas fa-map-marker-alt mr-2 mt-0.5 flex-shrink-0 text-purple-600"></i>
                        <span>{article.event_location}</span>
                      </div>
                    )}
                    
                    {/* Event Time for Events */}
                    {article.category === "event" && article.event_time && (
                      <div class="flex items-center text-sm text-gray-600 bg-purple-50 p-3 rounded-md">
                        <i class="fas fa-clock mr-2 text-purple-600"></i>
                        <span>{article.event_time}</span>
                      </div>
                    )}

                    {/* Media URL for media items */}
                    {article.category === "media" && article.media_url && (
                      <div class="flex items-center text-sm text-orange-700 bg-orange-50 p-3 rounded-md">
                        <i class="fas fa-external-link-alt mr-2 text-orange-500 flex-shrink-0"></i>
                        <span class="truncate">{article.media_url.replace(/^https?:\/\//, '').split('/')[0]}</span>
                      </div>
                    )}
                    
                    {/* Tags */}
                    {article.tags && article.tags.length > 0 && (
                      <div class="pt-3 border-t border-gray-200">
                        <div class="flex flex-wrap gap-2">
                          {article.tags.map((tag) => (
                            <span class="inline-block px-3 py-1.5 rounded-full text-sm bg-gray-100 text-gray-700 font-medium">
                              #{tag}
                            </span>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
    
    {articles.length === 0 && (
      <div class="text-center py-20 bg-white rounded-lg border-2 border-gray-200">
        <i class="fas fa-newspaper text-6xl text-gray-300 mb-4"></i>
        <p class="text-gray-500 text-lg">No recent news articles available</p>
      </div>
    )}
  </div>
</DigitalDisplayLayout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<script is:inline>
  // Refresh the news cards in place without reloading the page, so the
  // Curator widget loads (and counts a view) only once a day.
  (function () {
    var NEWS_REFRESH_MS = 10 * 60 * 1000; // check Directus news every 10 minutes
    var FULL_RELOAD_HOUR = 3;             // one full page reload per day, after 3 a.m.
    var loadedOn = new Date().toDateString();

    async function refreshNews() {
      try {
        var res = await fetch(location.href, { cache: 'no-store' });
        if (!res.ok) return;
        var doc = new DOMParser().parseFromString(await res.text(), 'text/html');
        var fresh = doc.getElementById('news-grid');
        var current = document.getElementById('news-grid');
        if (fresh && current && fresh.innerHTML !== current.innerHTML) {
          current.innerHTML = fresh.innerHTML;
        }
      } catch (e) {
        // Network blip: leave what's on screen and try again next interval.
      }
    }

    setInterval(function () {
      var now = new Date();
      if (now.toDateString() !== loadedOn && now.getHours() >= FULL_RELOAD_HOUR) {
        location.reload();
        return;
      }
      refreshNews();
    }, NEWS_REFRESH_MS);
  })();
</script>

<style>
  .digital-news-display {
    max-width: 2200px;
    margin: 0 auto;
    padding: 1.5rem 4rem;
  }
  
  .news-card-full {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .news-card-full:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  /* 3:2 aspect ratio for images */
  .news-image-container-full {
    position: relative;
    width: 100%;
    padding-top: 66.67%;
    overflow: hidden;
    background: #f3f4f6;
  }
  
  .news-image-full {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .news-image-placeholder-full {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
  }

  .news-image-placeholder-full.media-placeholder {
    background: linear-gradient(135deg, #fff7ed 0%, #fed7aa 100%);
  }
  
  /* Social Feed Styling */
  .social-feed-column {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .social-icons {
    display: inline-flex;
    gap: 0.6rem;
    margin-left: 0.75rem;
    font-size: 1.75rem;
    vertical-align: middle;
  }

  /* Fixed-height window so the feed can't push past the bottom of the screen */
  .social-feed-container {
    max-height: 2800px;
    overflow: hidden;
  }

  /* Curator injects its markup after render, so these need :global()
     to escape Astro's scoped styles. Class names are Curator's defaults;
     if one doesn't apply, check the live markup in DevTools. */
  .social-feed-container :global(.crt-post-text) {
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .social-feed-container :global(.crt-post-name),
  .social-feed-container :global(.crt-post-username) {
    font-size: 1.1rem;
  }

  /* Nobody can click "Load more" on a wall screen */
  .social-feed-container :global(.crt-load-more) {
    display: none;
  }

  /* Events band — full width under the header */
  .events-band {
    background: #fff;
    border: 2px solid #e5e7eb;
    border-top: 6px solid #7c3aed;   /* purple = events */
    border-radius: 0.75rem;
    padding: 0.5rem 2rem 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.06);
  }

  .display-section-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.875rem;
    font-weight: 700;
    color: #1e3a8a;
    margin: 0 0 0.75rem;
  }
  .display-section-title i { color: #7c3aed; }

  .events-list {
    list-style: none;
    margin: 0;
    padding: 0;
    column-gap: 3rem;
  }
  .events-list li::before, .events-list li::marker { content: none; }

  .event-row {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid #f1f5f9;
    min-width: 0;
  }

  .event-date {
    flex: 0 0 4.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.4rem 0;
    border-radius: 0.6rem;
    background: #eff6ff;
    color: #1e3a8a;
    line-height: 1.05;
  }
  .event-mon { font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .event-day { font-size: 1.9rem; font-weight: 800; }

  .event-body { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .event-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #1e3a8a;
    line-height: 1.25;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    font-size: 1rem;
    color: #4b5563;
    margin: 0;
  }
  .event-type { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; }
  .event-meta-icon { color: #7c3aed; margin-right: 0.3rem; }

  /* People on news cards */
  .people-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .people-more { font-size: 1rem; color: #6b7280; margin: 0; padding-left: 0.25rem; }

</style>