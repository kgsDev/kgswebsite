---
// src/pages/news/events.astro
export const prerender = false; // Enable SSR for this page
import NewsLayout from '../../layouts/NewsLayout.astro';
import NewsGrid from '../../components/news/NewsGrid.astro';
import SuscribeCalendar from '../../components/news/SuscribeCalendar.astro';
import Pagination from '../../components/Pagination.astro';
import { fetchEvents } from '../../lib/api_news';
import { EVENT_TYPES, isValidEventType } from '../../lib/eventTypes';

const params = Astro.url.searchParams;
const page = Math.max(1, parseInt(params.get('page') || '1') || 1);
const section = params.get('section') === 'past' ? 'past' : 'upcoming';
const rawType = params.get('type');
const type = rawType && isValidEventType(rawType) ? rawType : null; // ignore junk values
const limit = 9;

const isUpcoming = section === 'upcoming';
const { articles, totalPages } = await fetchEvents(limit, page, isUpcoming, type);

// Build event URLs while preserving section/type; changing filters resets to page 1
const eventsUrl = ({ section: s = section, type: t = type } = {}) => {
  const q = new URLSearchParams({ section: s });
  if (t) q.set('type', t);
  return `/news/events?${q}`;
};

const typeLabel = type ? EVENT_TYPES[type].label : null;
const title = `KGS in the Community: ${isUpcoming ? 'Upcoming' : 'Past'}${typeLabel ? ` · ${typeLabel}` : ''}`;
const description = isUpcoming
  ? "Talks, outreach tables, workshops, and KGS-hosted events coming up around Kentucky."
  : "Browse past KGS community events, talks, and outreach.";
---

<NewsLayout title={title} description={description}>
  <!-- Head Metadata -->
  <Fragment slot="head-meta">
    <title>{title} | Kentucky Geological Survey</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="text/calendar" title="KGS in the Community" href="/calendar/kgs-events.ics" />
  </Fragment>
  
  <!-- Custom Sidebar - OVERRRIDE NEWSLAYOUT sidebar-->
  <Fragment slot="sidebar">
    <div class="bg-white p-4 rounded-lg shadow mb-6">
      <h2 class="text-xl font-bold mb-4 text-blue-800">News Categories</h2>
      <ul class="space-y-2">
        <li><a href="/news" class="baselink">All News</a></li>
        <li><a href="/news/media" class="baselink">KGS in the Media</a></li>
        <li><a href="/news/press-releases" class="baselink">Press Releases</a></li>
        <li><a href="/news/research" class="baselink">Research Updates</a></li>
        <li><a href="/news/collection" class="baselink">From Our Collection</a></li>
        <li><a href="/news/events" class="baselink font-bold">KGS in the Community</a></li>
      </ul>
    </div>
    
    <!-- Event Type Navigation -->
    <div class="bg-white p-4 rounded-lg shadow mb-6">
      <h2 class="text-xl font-bold mb-4 text-blue-800">Event Timeline</h2>
      <ul class="space-y-2">
        <li>
          <a 
            href={eventsUrl({ section: 'upcoming' })}
            class={`baselink ${isUpcoming ? 'font-bold' : 'hover:underline'}`}
          >
            Upcoming Events
          </a>
        </li>
        <li>
          <a 
            href={eventsUrl({ section: 'past' })}
            class={`baselink ${!isUpcoming ? 'font-bold' : 'hover:underline'}`}
          >
            Past Events
          </a>
        </li>
      </ul>
    </div>
  </Fragment>
  
  <!-- Page Content -->
  <div>
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-3xl font-bold text-blue-900">KGS in the Community</h1>
        <h2>{isUpcoming ? "Upcoming Events" : "Past Events"}</h2>
      </div>
      
      <!-- Event timeline toggle -->
      <div class="inline-flex rounded-md shadow-sm">
        <a
          href="/news/events?section=upcoming"
          class={`px-4 py-2 text-sm font-medium rounded-l-lg ${
            isUpcoming
              ? 'bg-blue-600 text-white'
              : 'bg-white text-gray-700 hover:bg-gray-50'
          } border border-gray-300`}
        >
          Upcoming
        </a>
        <a
          href="/news/events?section=past"
          class={`px-4 py-2 text-sm font-medium rounded-r-lg ${
            !isUpcoming
              ? 'bg-blue-600 text-white'
              : 'bg-white text-gray-700 hover:bg-gray-50'
          } border border-l-0 border-gray-300`}
        >
          Past
        </a>
      </div>
    </div>
    
    <p class="text-gray-600 mb-4">{description}</p>
    
   <nav aria-label="Filter by event type" class="mb-8">
    <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
      <li class="list-none">
        <a
          href={eventsUrl({ type: null })}
          aria-current={!type ? 'page' : undefined}
          class={`chip ${!type ? 'chip-active' : ''}`}
        >
          All types
        </a>
      </li>
      {Object.entries(EVENT_TYPES).map(([key, t]) => (
        <li class="list-none">
          <a
            href={eventsUrl({ type: key })}
            aria-current={type === key ? 'page' : undefined}
            class={`chip ${type === key ? 'chip-active' : ''}`}
          >
            <i class={`fas ${t.icon} ${type === key ? '' : t.iconColor}`} aria-hidden="true"></i>
            {t.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <style>
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.375rem 0.875rem;
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.25rem;
      border: 1px solid #d1d5db;      /* gray-300 */
      border-radius: 9999px;
      background: #fff;
      color: #374151;                 /* gray-700 */
      text-decoration: none;
      transition: background-color 150ms, border-color 150ms;
    }
    .chip:hover {
      background: #f9fafb;            /* gray-50 */
      border-color: #9ca3af;          /* gray-400 */
      color: #1f2937;
      text-decoration: none;
    }
    .chip:focus-visible {
      outline: 2px solid #2563eb;
      outline-offset: 2px;
    }
    .chip-active,
    .chip-active:hover {
      background: #2563eb;            /* blue-600, matches the toggle */
      border-color: #2563eb;
      color: #fff;
    }
    /* Kill any global bullet/marker styles on this list */
    nav[aria-label="Filter by event type"] li::before,
    nav[aria-label="Filter by event type"] li::marker {
      content: none;
    }
  </style>

    {articles.length > 0 ? (
      <>
        <!-- Display News Grid with List Layout -->
        <NewsGrid articles={articles} layout="list" />
        
        <!-- Pagination -->
        <Pagination currentPage={page} totalPages={totalPages} baseUrl={eventsUrl()} />
      </>
    ) : (
      <div class="bg-white p-8 rounded-lg shadow-md text-center">
        <svg xmlns="http://www.w3.org/2000/svg" style="width: 4rem; height: 4rem;" class="mx-auto text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <h2 class="text-xl font-semibold text-gray-700 mb-2">
          {isUpcoming ? "No Upcoming Events" : "No Past Events Found"}
        </h2>
        <p class="text-gray-600">
          {isUpcoming
            ? `No upcoming ${typeLabel ? typeLabel.toLowerCase() + ' ' : ''}events right now. Check back soon.`
            : `No past ${typeLabel ? typeLabel.toLowerCase() + ' ' : ''}events found.`}
        </p>
      </div>
    )}
  </div>
</NewsLayout>