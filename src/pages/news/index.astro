---
// src/pages/news/index.astro
export const prerender = false;
import NewsLayout from '../../layouts/NewsLayout.astro';
import NewsGrid from '../../components/news/NewsGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { fetchNewsFiltered } from '../../lib/api_news';

// Read all relevant URL params
const page     = parseInt(Astro.url.searchParams.get('page') || '1');
const labSlug  = Astro.url.searchParams.get('lab')  || null;
const teamSlug = Astro.url.searchParams.get('team') || null;
const limit    = 9;

// Fetch news — with or without a filter
const {
  articles,
  totalCount,
  totalPages,
  filterLabel,
  filterType,
  filterNotFound,
} = await fetchNewsFiltered({ limit, page, labSlug, teamSlug });

// Build the base URL for pagination — preserve active filter params
const paginationBase = (() => {
  const params = new URLSearchParams();
  if (labSlug)  params.set('lab',  labSlug);
  if (teamSlug) params.set('team', teamSlug);
  const qs = params.toString();
  return qs ? `/news?${qs}` : '/news';
})();

// Clear-filter URL (back to /news with no filters)
const clearFilterUrl = '/news';

// Page title — contextual when filtered
const isFiltered = !!(labSlug || teamSlug);
const filterKindLabel = filterType === 'lab' ? 'Lab' : filterType === 'team' ? 'Research Team' : '';
const title       = isFiltered && filterLabel
  ? `News – ${filterLabel}`
  : 'News & Announcements';
const description = 'The latest news and announcements from the Kentucky Geological Survey.';
---

<NewsLayout title={title} description={description}>
  <Fragment slot="head-meta">
    <title>{title} | Kentucky Geological Survey</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </Fragment>

  <div>
    <h1 class="text-3xl font-bold text-blue-900 mb-2">
      {isFiltered && filterLabel ? `${filterLabel} News` : 'News & Announcements'}
    </h1>

    {/* Active filter banner */}
    {isFiltered && (
      <div class={`mb-6 flex items-center justify-between gap-4 rounded-lg border px-4 py-3 text-sm
        ${filterNotFound
          ? 'border-red-200 bg-red-50 text-red-800'
          : filterType === 'lab'
            ? 'border-green-200 bg-green-50 text-green-800'
            : 'border-indigo-200 bg-indigo-50 text-indigo-800'
        }`}>
        <div class="flex items-center gap-2">
          <i class={`fas ${filterNotFound ? 'fa-exclamation-circle' : filterType === 'lab' ? 'fa-flask' : 'fa-users'}`}></i>
          {filterNotFound ? (
            <span>
              No {filterKindLabel ? filterKindLabel.toLowerCase() : 'filter'} found matching
              <strong class="mx-1">"{labSlug || teamSlug}"</strong>
              — showing no results.
            </span>
          ) : (
            <span>
              Filtered by {filterKindLabel}:
              <strong class="ml-1">{filterLabel}</strong>
              {totalCount > 0 && (
                <span class="ml-2 font-normal opacity-75">({totalCount} article{totalCount !== 1 ? 's' : ''})</span>
              )}
            </span>
          )}
        </div>
        <a
          href={clearFilterUrl}
          class="flex items-center gap-1 whitespace-nowrap rounded-md border border-current px-3 py-1 font-medium opacity-80 hover:opacity-100 transition"
          aria-label="Clear filter and show all news"
        >
          <i class="fas fa-times"></i>
          Clear filter
        </a>
      </div>
    )}

    {!isFiltered && (
      <p class="text-gray-600 mb-8">Stay informed with the latest news and announcements from the Kentucky Geological Survey.</p>
    )}

    {articles.length > 0 ? (
      <>
        <NewsGrid articles={articles} layout={isFiltered ? 'list' : 'featured'} />
        <Pagination
          currentPage={page}
          totalPages={totalPages}
          baseUrl={paginationBase}
        />
      </>
    ) : (
      <div class="bg-white p-8 rounded-lg shadow-md text-center">
        <svg xmlns="http://www.w3.org/2000/svg" style="width: 4rem; height: 4rem;" class="mx-auto text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        {isFiltered ? (
          <>
            <h2 class="text-xl font-semibold text-gray-700 mb-2">No articles found</h2>
            <p class="text-gray-600 mb-4">
              There are no published news articles linked to this {filterKindLabel.toLowerCase()}.
            </p>
            <a href={clearFilterUrl} class="inline-flex items-center gap-2 text-blue-600 hover:underline font-medium">
              <i class="fas fa-arrow-left"></i>
              View all news
            </a>
          </>
        ) : (
          <>
            <h2 class="text-xl font-semibold text-gray-700 mb-2">No News Articles Yet</h2>
            <p class="text-gray-600">Check back soon for updates and announcements.</p>
          </>
        )}
      </div>
    )}
  </div>
</NewsLayout>