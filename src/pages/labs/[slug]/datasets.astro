---
// src/pages/labs/[slug]/datasets.astro
export const prerender = false;

import LabLayout from '../../../layouts/LabLayout.astro';
import DatasetDownloadModal from '../../../components/DatasetDownloadModal.astro';
import { fetchLabBySlug } from '../../../lib/api_labs';
import directus from '../../../../lib/directus';
import { readItems } from '@directus/sdk';

// Get the lab for this page
const { slug } = Astro.params;
const lab = await fetchLabBySlug(slug);

// Handle 404 if lab not found
if (!lab) {
  return Astro.redirect('/404');
}

// Fetch datasets for this lab through the junction table
let datasets = [];
try {
  const labDatasets = await directus.request(readItems("datasets_labs", {
    fields: [
      'datasets_id.id',
      'datasets_id.status',
      'datasets_id.title',
      'datasets_id.description',
      'datasets_id.format',
      'datasets_id.file_size',
      'datasets_id.date_uploaded',
      'datasets_id.file.id',
      'datasets_id.file.filename_download',
      'datasets_id.file.type',
      'datasets_id.file.filesize'
    ],
    filter: {
      labs_id: { _eq: lab.id },
      datasets_id: {
        status: { _eq: 'published' }
      }
    },
    sort: ['-datasets_id.date_uploaded']
  }));

  datasets = labDatasets
    .map(item => item.datasets_id)
    .filter(Boolean)
    .filter(dataset => dataset && dataset.id);

} catch (error) {
  console.error("Error fetching datasets:", error);
}

// Helper function to format file size
function formatFileSize(bytes: number | null | undefined): string {
  if (!bytes) return '';
  const kb = bytes / 1024;
  const mb = kb / 1024;
  if (mb >= 1) return `${mb.toFixed(1)} MB`;
  return `${kb.toFixed(0)} KB`;
}

// Helper function to format date
const formatDate = (dateString) => {
  if (!dateString) return null;
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

// Group datasets by year
const datasetsByYear = {};
datasets.forEach(dataset => {
  const year = dataset.date_uploaded ? new Date(dataset.date_uploaded).getFullYear() : 'No Date';
  if (!datasetsByYear[year]) {
    datasetsByYear[year] = [];
  }
  datasetsByYear[year].push(dataset);
});

// Get unique years for navigation
const years = Object.keys(datasetsByYear).sort((a, b) => {
  if (a === 'No Date') return 1;
  if (b === 'No Date') return -1;
  return Number(b) - Number(a);
});
---

<LabLayout lab={lab} activePage="datasets" pageTitle="Datasets">
  <div class="space-y-8">
    <!-- Page Header -->
    <div class="content-block p-6">
      <h1 class="text-2xl mb-4 lab-primary-text">Research Datasets</h1>
      <p class="text-gray-600 mb-4">
        Access research datasets from the {lab.short_name || lab.name} lab. Download requires providing contact information to help us track usage and improve our services.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <span class="text-gray-600">Total Datasets: <strong>{datasets.length}</strong></span>
        {years.length > 1 && (
          <div class="flex flex-wrap gap-2">
            <span class="text-gray-600">Years:</span>
            {years.map((year, index) => (
              <span class="inline-flex items-center">
                <a 
                  href={`#year-${year}`} 
                  class="lab-secondary-text hover:lab-primary-text transition-colors duration-300 font-medium"
                >
                  {year}
                </a>
                {index < years.length - 1 && <span class="text-gray-400 ml-1">•</span>}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Datasets by Year -->
    {years.map(year => (
      <div id={`year-${year}`} class="content-block p-6">
        <div class="flex items-center mb-6">
          <div class="w-3 h-3 bg-blue-500 rounded-full mr-3"></div>
          <h2 class="text-xl font-bold lab-secondary-text">{year}</h2>
          <span class="ml-3 bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-sm font-medium">
            {datasetsByYear[year].length}
          </span>
        </div>
        
        <div class="space-y-6">
          {datasetsByYear[year].map((dataset) => (
            <div class="border-l-4 border-blue-500 pl-6 pb-6 border-b border-gray-100 last:border-b-0">
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex-1">
                  <h3 class="text-lg font-semibold lab-primary-text mb-2">{dataset.title}</h3>
                  
                  {dataset.description && (
                    <div class="dataset-description prose max-w-none text-gray-700 mb-4" set:html={dataset.description} />
                  )}
                  
                  <!-- Dataset Metadata -->
                  <div class="flex flex-wrap gap-3 text-sm mb-4">
                    {dataset.format && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-100 rounded-full text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                        {dataset.format}
                      </span>
                    )}
                    
                    {dataset.file?.filesize && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-100 rounded-full text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
                        </svg>
                        {formatFileSize(dataset.file.filesize)}
                      </span>
                    )}
                    
                    {dataset.date_uploaded && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-100 rounded-full text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        {formatDate(dataset.date_uploaded)}
                      </span>
                    )}
                  </div>
                </div>
                
                <!-- Download Button -->
                <button 
                  class="download-dataset-btn flex-shrink-0"
                  data-file-id={dataset.file?.id}
                  data-dataset-id={dataset.id}
                  data-filename={dataset.file?.filename_download}
                  type="button"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  <span>Download Dataset</span>
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <!-- No Datasets Message -->
    {datasets.length === 0 && (
      <div class="content-block p-8">
        <div class="text-center py-8">
          <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No datasets available</h3>
          <p class="mt-1 text-sm text-gray-500">Datasets will appear here once they are added to the lab.</p>
        </div>
      </div>
    )}
    
    <!-- Back to Top Button for long dataset lists -->
    {datasets.length > 5 && (
      <div class="content-block p-4">
        <div class="text-center">
          <a 
            href="#top" 
            class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
            Back to Top
          </a>
        </div>
      </div>
    )}
  </div>

  <!-- Dataset Download Modal -->
  <DatasetDownloadModal />
</LabLayout>

<style>
  .download-dataset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: #0033A0;
    color: white;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .download-dataset-btn:hover {
    background: #002875;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .download-dataset-btn:active {
    transform: translateY(0);
  }

  .dataset-description :global(p) {
    margin: 0 0 0.5rem 0;
  }

  .dataset-description :global(p:last-child) {
    margin-bottom: 0;
  }

  .dataset-description :global(ul),
  .dataset-description :global(ol) {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
  }
</style>

<script>
  // Initialize dataset download buttons
  document.addEventListener('DOMContentLoaded', () => {
    const downloadButtons = document.querySelectorAll('.download-dataset-btn');
    
    downloadButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        const btn = e.currentTarget as HTMLElement;
        const fileId = btn.dataset.fileId;
        const datasetId = btn.dataset.datasetId;
        const filename = btn.dataset.filename;
        
        if (fileId && datasetId && filename) {
          // Call the global function defined in DatasetDownloadModal
          (window as any).openDatasetDownload(fileId, datasetId, filename);
        }
      });
    });
  });
</script>