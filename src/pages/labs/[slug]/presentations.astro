---
// src/pages/labs/[slug]/presentations.astro
export const prerender = false; // Enable SSR for this page

import LabLayout from '../../../layouts/LabLayout.astro';
import { 
  fetchLabBySlug, 
  fetchLabPresentations 
} from '../../../lib/api_labs';

// Get the lab for this page
const { slug } = Astro.params;
const lab = await fetchLabBySlug(slug);

// Handle 404 if lab not found
if (!lab) {
  return Astro.redirect('/404');
}

// Get presentations for this lab grouped by year
const presentationsByYear = await fetchLabPresentations(lab.id, { yearGroup: true });
const years = Object.keys(presentationsByYear).sort((a, b) => {
  // Handle "Unknown Year" case
  if (a === 'Unknown Year') return 1;
  if (b === 'Unknown Year') return -1;
  return b - a; // Sort years descending
});

// Format date nicely
const formatDate = (dateString) => {
  if (!dateString) return null;
  
  const date = new Date(dateString);
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
};

// Get total count of presentations
const totalPresentations = years.reduce((sum, year) => sum + presentationsByYear[year].length, 0);
---

<LabLayout lab={lab} activePage="presentations" pageTitle="Presentations">
  <div class="space-y-8">
    <!-- Page Header -->
    <div class="content-block p-6">
      <h1 class="text-2xl mb-4 lab-primary-text">Presentations</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <span class="text-gray-600">Total Presentations: <strong>{totalPresentations}</strong></span>
        {years.length > 1 && (
          <div class="flex flex-wrap gap-2">
            <span class="text-gray-600">Years:</span>
            {years.map((year, index) => (
              <span class="inline-flex items-center">
                <a 
                  href={`#year-${year}`} 
                  class="lab-secondary-text hover:lab-primary-text transition-colors duration-300 font-medium"
                >
                  {year}
                </a>
                {index < years.length - 1 && <span class="text-gray-400 ml-1">•</span>}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    {years.length === 0 ? (
      <div class="content-block p-8">
        <div class="text-center py-8">
          <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No presentations found</h3>
          <p class="mt-1 text-sm text-gray-500">Presentations will appear here once they are added to the lab.</p>
        </div>
      </div>
    ) : (
      <>
        {/* Presentations by Year */}
        {years.map(year => (
          <div id={`year-${year}`} class="content-block p-6">
            <div class="flex items-center mb-6">
              <div class="w-3 h-3 bg-blue-500 rounded-full mr-3"></div>
              <h2 class="text-xl font-bold lab-secondary-text">{year}</h2>
              <span class="ml-3 bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-sm font-medium">
                {presentationsByYear[year].length}
              </span>
            </div>
            
            <div class="space-y-6">
              {presentationsByYear[year].map((presentation) => (
                <div class="border-l-4 border-blue-500 pl-6 pb-6 border-b border-gray-100 last:border-b-0">
                  {/* Title */}
                  <h3 class="text-lg font-semibold lab-primary-text mb-3">{presentation.title}</h3>
                  
                  {/* Citation (WYSIWYG content) */}
                  {presentation.citation && (
                    <div class="mb-4 p-3 bg-gray-50 rounded-lg">
                      <h4 class="font-medium text-gray-900 mb-2 text-sm">Citation</h4>
                      <div 
                        class="text-sm text-gray-700 leading-relaxed prose prose-sm max-w-none"
                        set:html={presentation.citation}
                      />
                    </div>
                  )}
                  
                  {/* Optional Metadata */}
                  {(presentation.venue || presentation.location || presentation.date || presentation.type || presentation.presenter) && (
                    <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-600 mb-3">
                      {presentation.presenter && (
                        <div class="flex items-start">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 mt-0.5 flex-shrink-0 lab-accent-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                          </svg>
                          <div>
                            <strong>Presenter:</strong> {presentation.presenter}
                          </div>
                        </div>
                      )}
                      
                      {presentation.venue && (
                        <div class="flex items-start">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 mt-0.5 flex-shrink-0 lab-accent-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                          </svg>
                          <div>
                            <strong>Venue:</strong> {presentation.venue}
                          </div>
                        </div>
                      )}
                      
                      {presentation.date && (
                        <div class="flex items-start">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 mt-0.5 flex-shrink-0 lab-accent-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                          </svg>
                          <div>
                            <strong>Date:</strong> {formatDate(presentation.date)}
                          </div>
                        </div>
                      )}
                      
                      {presentation.location && (
                        <div class="flex items-start">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 mt-0.5 flex-shrink-0 lab-accent-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          <div>
                            <strong>Location:</strong> {presentation.location}
                          </div>
                        </div>
                      )}
                      
                      {presentation.type && (
                        <div class="flex items-start">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 mt-0.5 flex-shrink-0 lab-accent-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                          </svg>
                          <div>
                            <strong>Type:</strong> {presentation.type}
                          </div>
                        </div>
                      )}
                    </div>
                  )}
                  
                  {/* Abstract or Description */}
                  {presentation.abstract && (
                    <div class="mb-4">
                      <h4 class="font-medium text-gray-900 mb-2">Abstract</h4>
                      <p class="text-gray-700 text-sm leading-relaxed">{presentation.abstract}</p>
                    </div>
                  )}
                  
                  {/* Links */}
                  {(presentation.slides_url || presentation.video_url || presentation.doi || presentation.paper_url) && (
                    <div class="flex flex-wrap gap-3 text-sm">
                      {presentation.slides_url && (
                        <a 
                          href={presentation.slides_url} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                          </svg>
                          View Slides
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}
                      
                      {presentation.video_url && (
                        <a 
                          href={presentation.video_url} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          Watch Video
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}
                      
                      {presentation.doi && (
                        <a 
                          href={`https://doi.org/${presentation.doi}`} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                          </svg>
                          DOI Link
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}
                      
                      {presentation.paper_url && (
                        <a 
                          href={presentation.paper_url} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                          </svg>
                          View Paper
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}

        {/* Back to Top Button for long presentation lists */}
        {totalPresentations > 5 && (
          <div class="content-block p-4">
            <div class="text-center">
              <a 
                href="#top" 
                class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
                Back to Top
              </a>
            </div>
          </div>
        )}
      </>
    )}
  </div>
</LabLayout>