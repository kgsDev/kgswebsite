---
// src/pages/labs/[slug]/publications.astro
export const prerender = false; // Enable SSR for this page

import LabLayout from '../../../layouts/LabLayout.astro';
import { fetchLabBySlug } from '../../../lib/api_labs';

// Get the lab for this page
const { slug } = Astro.params;
const lab = await fetchLabBySlug(slug);
const pending_pubs = lab?.pending_pubs || '';

// Handle 404 if lab not found
if (!lab) {
  return Astro.redirect('/404');
}

const pubsDbUrl = "https://kgs.uky.edu/dpub";

// Fetch publications for this lab from external database
let publications = [];

try {
  // Fetch the lab with nested publications and authors through the M2M relationships
  const labResponse = await fetch(
    `${pubsDbUrl}/items/kygs_lab?filter[kygs_id][_eq]=${lab.id}&fields=id,use_kygs_sort,publications.publications_id.id,publications.publications_id.title,publications.publications_id.publication_year,publications.publications_id.url_download,publications.publications_id.url_webpage,publications.publications_id.cover,publications.publications_id.kygs_lab_featured,publications.publications_id.kygs_sort,publications.publications_id.author_id.authors_id.first_name,publications.publications_id.author_id.authors_id.middle_name,publications.publications_id.author_id.authors_id.last_name,publications.publications_id.author_id.authors_id.prefix,publications.publications_id.author_id.authors_id.suffix`
  );
  
  if (!labResponse.ok) {
    throw new Error(`Failed to fetch lab data: ${labResponse.status}`);
  }
  
  const labData = await labResponse.json();
  
  // The response is an array, get the first (and should be only) match
  const labFromPubs = labData.data?.[0];
  
  // Extract the actual publications from the junction table structure
  if (labFromPubs?.publications && Array.isArray(labFromPubs.publications)) {
    publications = labFromPubs.publications
      .map(junction => junction.publications_id)
      .filter(pub => pub && pub.id); // Filter out any null/undefined entries
    
    // Sort publications: featured first, then by kygs_sort (if present), then by year (descending), then by title
    publications.sort((a, b) => {
      // Check if either pub is featured for this lab
      const aFeatured = Array.isArray(a.kygs_lab_featured) && a.kygs_lab_featured.includes(lab.id);
      const bFeatured = Array.isArray(b.kygs_lab_featured) && b.kygs_lab_featured.includes(lab.id);
      
      if (aFeatured && !bFeatured) return -1;
      if (!aFeatured && bFeatured) return 1;
      
      // If both featured or both not featured, check for kygs_sort
      if(labFromPubs.use_kygs_sort) {
        const aSort = a.kygs_sort ?? null;
        const bSort = b.kygs_sort ?? null;
        
        // If both have kygs_sort values, sort by those (ascending - lower numbers first)
        if (aSort !== null && bSort !== null) {
          if (aSort !== bSort) return aSort - bSort;
        }
        // If only one has kygs_sort, prioritize it
        if (aSort !== null && bSort === null) return -1;
        if (aSort === null && bSort !== null) return 1;
      }
      
      // If neither has kygs_sort or they're equal, sort by year descending
      if (b.publication_year !== a.publication_year) {
        return b.publication_year - a.publication_year;
      }
      
      // Finally sort by title
      return (a.title || '').localeCompare(b.title || '');
    });
  }

} catch (error) {
  console.error("Error fetching publications:", error);
}

// Helper function to format authors from M2M junction table
function formatAuthors(authorJunctions) {
  if (!Array.isArray(authorJunctions) || authorJunctions.length === 0) return '';
  
  // Extract author objects from junction table
  const authors = authorJunctions
    .map(junction => junction.authors_id)
    .filter(author => author && (author.first_name || author.last_name));
  
  if (authors.length === 0) return '';
  
  // Format each author name with prefix, first, middle, last, suffix
  const authorNames = authors.map(author => {
    const parts = [];
    if (author.prefix) parts.push(author.prefix);
    if (author.first_name) parts.push(author.first_name);
    if (author.middle_name) parts.push(author.middle_name);
    if (author.last_name) parts.push(author.last_name);
    if (author.suffix) parts.push(author.suffix);
    return parts.join(' ').trim();
  }).filter(name => name.length > 0);
  
  if (authorNames.length === 0) return '';
  if (authorNames.length === 1) return authorNames[0];
  if (authorNames.length === 2) return `${authorNames[0]} and ${authorNames[1]}`;
  
  // For 3+ authors, list all with commas and "and" before the last
  const lastAuthor = authorNames[authorNames.length - 1];
  const otherAuthors = authorNames.slice(0, -1);
  return `${otherAuthors.join(', ')}, and ${lastAuthor}`;
}

// Helper function to get publication URL (prefer webpage, fallback to download)
function getPubUrl(pub) {
  return pub.url_webpage || pub.url_download || null;
}

// Group publications by year for better organization
const publicationsByYear = {};
publications.forEach(pub => {
  const year = pub.publication_year || 'No Date';
  if (!publicationsByYear[year]) {
    publicationsByYear[year] = [];
  }
  publicationsByYear[year].push(pub);
});

// Get unique years for navigation
const years = Object.keys(publicationsByYear).sort((a, b) => {
  if (a === 'No Date') return 1;
  if (b === 'No Date') return -1;
  return b - a;
});
---

<LabLayout lab={lab} activePage="publications" pageTitle="Publications">
  <div class="space-y-8">
    <!-- Page Header -->
    <div class="content-block p-6">
      <h1 class="text-2xl mb-4 lab-primary-text">Publications</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <span class="text-gray-600">Total Publications: <strong>{publications.length}</strong></span>
        {years.length > 1 && (
          <div class="flex flex-wrap gap-2">
            <span class="text-gray-600">Years:</span>
            {years.map((year, index) => (
              <span class="inline-flex items-center">
                <a 
                  href={`#year-${year}`} 
                  class="lab-secondary-text hover:lab-primary-text transition-colors duration-300 font-medium"
                >
                  {year}
                </a>
                {index < years.length - 1 && <span class="text-gray-400 ml-1">•</span>}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Pending Publications -->
    {pending_pubs && pending_pubs.trim() !== '' && (
    <div class="content-block p-6">
      <h2 class="text-xl font-bold lab-secondary-text">Pending Publications</h2>
      <div 
        class="text-gray-700 text-sm leading-relaxed prose prose-sm max-w-none"
        set:html={pending_pubs}
      />
    </div>
    )}

    <!-- Publications by Year -->
    {years.map(year => (
      <div id={`year-${year}`} class="content-block p-6">
        <div class="flex items-center mb-6">
          <div class="w-3 h-3 bg-blue-500 rounded-full mr-3"></div>
          <h2 class="text-xl font-bold lab-secondary-text">{year}</h2>
          <span class="ml-3 bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-sm font-medium">
            {publicationsByYear[year].length}
          </span>
        </div>
        
        <div class="space-y-6">
          {publicationsByYear[year].map((pub) => {
            const pubUrl = getPubUrl(pub);
            const authors = formatAuthors(pub.author_id);
            const isFeatured = Array.isArray(pub.kygs_lab_featured) && pub.kygs_lab_featured.includes(lab.id);
            
            return (
              <div class={`border-l-4 ${isFeatured ? 'border-blue-600' : 'border-blue-500'} pl-6 pb-6 border-b border-gray-100 last:border-b-0`}>
                <div class="flex gap-4">
                  {/* Thumbnail */}
                  {pub.cover && (
                    <div class="flex-shrink-0">
                      <img 
                        src={`${pubsDbUrl}/assets/${pub.cover}?width=200&quality=80`}
                        alt={`Cover for ${pub.title}`}
                        class="w-24 h-32 object-cover object-top rounded shadow-sm"
                        loading="lazy"
                      />
                    </div>
                  )}
                  
                  <div class="flex-1 min-w-0">
                    <div class="mb-3">
                      {isFeatured && (
                        <span class="inline-block bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-1 rounded mb-2">
                          Featured
                        </span>
                      )}
                      
                      <h3 class="text-lg font-semibold lab-primary-text mb-2">
                        {pubUrl ? (
                          <a href={pubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline" aria-label={`View publication "${pub.title}"`}>
                            {pub.title}
                          </a>
                        ) : (
                          pub.title
                        )}
                      </h3>
                      
                      {authors && (
                        <p class="text-gray-700 mb-2">
                          <strong>KGS-Affiliated Authors:</strong> {authors}
                        </p>
                      )}
                      
                      <div class="text-sm text-gray-600">
                        <strong>Year:</strong> {pub.publication_year}
                      </div>
                    </div>
                    
                    {/* Links */}
                    <div class="flex flex-wrap gap-3 text-sm">
                      {pub.url_webpage && (
                        <a 
                          href={pub.url_webpage} 
                          target="_blank" 
                          rel="noopener noreferrer"
                          class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
                          aria-label={`View publication "${pub.title}" on its webpage`}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                          </svg>
                          View Publication
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}
                      
                      {pub.url_download && (
                        <a 
                          href={pub.url_download} 
                          target="_blank" 
                          rel="noopener noreferrer"
                          class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
                          aria-label={`Download PDF for publication "${pub.title}"`}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                          </svg>
                          Download PDF
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}

    <!-- No Publications Message -->
    {publications.length === 0 && (
      <div class="content-block p-8">
        <div class="text-center py-8">
          <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No publications found</h3>
          <p class="mt-1 text-sm text-gray-500">Publications will appear here once they are added to the lab.</p>
        </div>
      </div>
    )}
    
    <!-- Back to Top Button for long publication lists -->
    {publications.length > 5 && (
      <div class="content-block p-4">
        <div class="text-center">
          <a 
            href="#top" 
            class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
            Back to Top
          </a>
        </div>
      </div>
    )}
  </div>
</LabLayout>