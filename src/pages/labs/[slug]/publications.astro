---
// src/pages/labs/[slug]/publications.astro
export const prerender = false; // Enable SSR for this page

import LabLayout from '../../../layouts/LabLayout.astro';
import LabPublicationItem from '../../../components/labs/LabPublicationItem.astro';
import { fetchLabBySlug } from '../../../lib/api_labs';

const { slug } = Astro.params;
const lab = await fetchLabBySlug(slug);

if (!lab) {
  return Astro.redirect('/404');
}

const pending_pubs = lab.pending_pubs || '';
const pubsDbUrl = "https://kgs.uky.edu/dpub";

// ── Pubs DB structure ─────────────────────────────────────────────────────────
// publications ↔ kygs_lab through the junction `publications_kygs_lab`
// (publications_id → publications.id, kygs_lab_id → kygs_lab.id).
// We query the junction directly, the same way fetchTeamPresentations does, and
// match the lab by kygs_lab.kygs_id (the website's lab id).
const JUNCTION = 'publications_kygs_lab';

const PUB_FIELDS = [
  'id', 'title', 'publication_year', 'url_download', 'url_webpage', 'cover',
  'kygs_featured_lab', 'kygs_sort',
  'author_id.authors_id.first_name', 'author_id.authors_id.middle_name',
  'author_id.authors_id.last_name', 'author_id.authors_id.prefix',
  'author_id.authors_id.suffix',
].map((f) => `publications_id.${f}`).join(',');

// fetch + JSON, surfacing Directus's error message (e.g. a permissions error) in the log.
async function getJson(url: string, label: string) {
  const res = await fetch(url);
  if (!res.ok) {
    const body = await res.text().catch(() => '');
    throw new Error(`${label} → ${res.status}: ${body.slice(0, 400)}`);
  }
  return res.json();
}

let featured: any[] = [];
let others: any[] = [];

try {
  const junctionFilter = encodeURIComponent(JSON.stringify({
    kygs_lab_id: { kygs_id: { _eq: lab.id } },
  }));

  const [labRow, junctionData] = await Promise.all([
    // fields=* returns only the fields the Public role can read, so a missing or
    // locked-down use_kygs_sort just comes back absent instead of a 403.
    getJson(`${pubsDbUrl}/items/kygs_lab?filter[kygs_id][_eq]=${lab.id}&fields=*&limit=1`, 'kygs_lab')
      .then((d) => d.data?.[0] ?? null)
      .catch((err) => { console.error('Error fetching lab row:', err.message); return null; }),
    getJson(`${pubsDbUrl}/items/${JUNCTION}?filter=${junctionFilter}&fields=${PUB_FIELDS}&limit=-1`, JUNCTION),
  ]);

  const useKygsSort = labRow?.use_kygs_sort === true;

  const compare = (a: any, b: any) => {
    if (useKygsSort) {
      const aSort = a.kygs_sort ?? null;
      const bSort = b.kygs_sort ?? null;
      if (aSort !== null && bSort !== null && aSort !== bSort) return aSort - bSort;
      if (aSort !== null && bSort === null) return -1;
      if (aSort === null && bSort !== null) return 1;
    }
    if (b.publication_year !== a.publication_year) {
      return (b.publication_year || 0) - (a.publication_year || 0);
    }
    return (a.title || '').localeCompare(b.title || '');
  };

  // Unwrap junction rows and de-duplicate (a pub linked to the lab twice shows once).
  const seen = new Set();
  const publications = (junctionData.data || [])
    .map((row: any) => row.publications_id)
    .filter((pub: any) => pub && pub.id && !seen.has(pub.id) && seen.add(pub.id));

  // kygs_featured_lab is a boolean on the publication (true / false / null).
  featured = publications.filter((pub: any) => pub.kygs_featured_lab === true).sort(compare);
  others = publications.filter((pub: any) => pub.kygs_featured_lab !== true).sort(compare);
} catch (error) {
  console.error("Error fetching lab publications:", error);
}

const totalPubs = featured.length + others.length;

// Non-featured publications grouped by year (featured ones aren't repeated here).
const publicationsByYear: Record<string, any[]> = {};
others.forEach((pub) => {
  const year = pub.publication_year ? String(pub.publication_year) : 'No Date';
  (publicationsByYear[year] ||= []).push(pub);
});

const years = Object.keys(publicationsByYear).sort((a, b) => {
  if (a === 'No Date') return 1;
  if (b === 'No Date') return -1;
  return Number(b) - Number(a);
});

// Jump links: Featured first (if any), then years.
const jumpLinks = [
  ...(featured.length ? [{ href: '#featured', label: 'Featured' }] : []),
  ...years.map((year) => ({ href: `#year-${year}`, label: year })),
];
---

<LabLayout lab={lab} activePage="publications" pageTitle="Publications">
  <div class="space-y-8">
    <!-- Page Header -->
    <div class="content-block p-6">
      <h1 class="text-2xl mb-4 lab-primary-text">Publications</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <span class="text-gray-600">Total Publications: <strong>{totalPubs}</strong></span>
        {jumpLinks.length > 1 && (
          <nav aria-label="Jump to section" class="flex flex-wrap gap-2">
            <span class="text-gray-600">Jump to:</span>
            {jumpLinks.map((link, index) => (
              <span class="inline-flex items-center">
                <a
                  href={link.href}
                  class="lab-secondary-text hover:lab-primary-text transition-colors duration-300 font-medium"
                >
                  {link.label}
                </a>
                {index < jumpLinks.length - 1 && <span class="text-gray-400 ml-1" aria-hidden="true">•</span>}
              </span>
            ))}
          </nav>
        )}
      </div>
    </div>

    <!-- Pending Publications -->
    {pending_pubs && pending_pubs.trim() !== '' && (
      <div class="content-block p-6">
        <h2 class="text-xl font-bold lab-secondary-text">Pending Publications</h2>
        <div
          class="text-gray-700 text-sm leading-relaxed prose prose-sm max-w-none"
          set:html={pending_pubs}
        />
      </div>
    )}

    <!-- Featured Publications -->
    {featured.length > 0 && (
      <div id="featured" class="content-block p-6 featured-block">
        <div class="flex items-center mb-6">
          <i class="fas fa-star featured-star mr-3" aria-hidden="true"></i>
          <h2 class="text-xl font-bold lab-primary-text">Featured Publications</h2>
          <span class="ml-3 bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-sm font-medium">
            {featured.length}
          </span>
        </div>
        <div class="space-y-6">
          {featured.map((pub) => (
            <LabPublicationItem pub={pub} pubsDbUrl={pubsDbUrl} featured={true} />
          ))}
        </div>
      </div>
    )}

    <!-- Publications by Year -->
    {years.map((year) => (
      <div id={`year-${year}`} class="content-block p-6">
        <div class="flex items-center mb-6">
          <div class="w-3 h-3 bg-blue-500 rounded-full mr-3" aria-hidden="true"></div>
          <h2 class="text-xl font-bold lab-secondary-text">{year}</h2>
          <span class="ml-3 bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-sm font-medium">
            {publicationsByYear[year].length}
          </span>
        </div>
        <div class="space-y-6">
          {publicationsByYear[year].map((pub) => (
            <LabPublicationItem pub={pub} pubsDbUrl={pubsDbUrl} />
          ))}
        </div>
      </div>
    ))}

    <!-- No Publications Message -->
    {totalPubs === 0 && (
      <div class="content-block p-8">
        <div class="text-center py-8">
          <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No publications found</h3>
          <p class="mt-1 text-sm text-gray-500">Publications will appear here once they are added to the lab.</p>
        </div>
      </div>
    )}

    <!-- Back to Top Button for long publication lists -->
    {totalPubs > 5 && (
      <div class="content-block p-4">
        <div class="text-center">
          <a
            href="#top"
            class="inline-flex items-center lab-secondary-text hover:lab-primary-text transition-colors duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
            Back to Top
          </a>
        </div>
      </div>
    )}
  </div>
</LabLayout>

<style>
  .featured-block {
    background: #f0f4fb;
    border: 1px solid #c7d4ee;
    border-top: 5px solid #0033A0;
  }
  .featured-star {
    color: #0033A0;
    font-size: 1.125rem;
  }
</style>