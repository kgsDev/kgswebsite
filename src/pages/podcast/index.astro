---
// src/pages/podcast/index.astro
// The Big Blue Rock Pod — episode directory, filterable by topic and searchable by text.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchAllEpisodes, fetchAllTopics, stripHtml } from '../../lib/api_podcast';
import { PODCAST_DEFAULT_IMAGE } from '../../lib/podcast_config';

const [episodes, topics] = await Promise.all([fetchAllEpisodes(), fetchAllTopics()]);

// Count episodes per topic; only show topics that have at least one episode.
const counts = new Map();
episodes.forEach(ep => ep.topics.forEach(t => counts.set(t.slug, (counts.get(t.slug) || 0) + 1)));
const usedTopics = topics.filter(t => counts.has(t.slug));

const activeSlug = Astro.url.searchParams.get('topic');
const activeTopic = topics.find(t => t.slug === activeSlug);
const shown = activeTopic
  ? episodes.filter(ep => ep.topics.some(t => t.slug === activeSlug))
  : episodes;

const formatDate = d => d
  ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/New_York' })
  : '';

const formatDuration = seconds => {
  const totalSeconds = Number(seconds);
  if (!Number.isFinite(totalSeconds)) return '';
  const minutes = Math.floor(totalSeconds / 60);
  const remainingSeconds = Math.floor(totalSeconds % 60).toString().padStart(2, '0');
  return `${minutes}:${remainingSeconds}`;
};

// Topic filter buttons. These links deliberately live outside <ul>/<p>: global.css styles
// `ul a` / `p a` with unlayered rules, which beat Tailwind v4 utilities (they're in @layer).
const btnBase = 'inline-flex items-center gap-2 px-4 py-2 rounded-md border text-sm font-medium no-underline shadow-sm transition-colors';
const btnOn = 'bg-[#0033A0] border-[#0033A0] text-white hover:bg-[#1B365D] hover:border-[#1B365D]';
const btnOff = 'bg-white border-gray-300 text-[#1B365D] hover:border-[#0033A0] hover:bg-blue-50';
const badgeOn = 'rounded-full bg-white/20 px-2 py-0.5 text-xs';
const badgeOff = 'rounded-full bg-gray-100 text-gray-700 px-2 py-0.5 text-xs';

const title = activeTopic ? `${activeTopic.name} – The Big Blue Rock Pod` : 'The Big Blue Rock Pod';
const description = 'Every episode of The Big Blue Rock Pod from the Kentucky Geological Survey, organized by topic.';

Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
---

<BaseLayout title={title} description={description} activePage="podcast" showBreadcrumb={true}>
  <div class="container mx-auto px-4 py-1">
    <div class="mb-6">
      <h1><i class="fas fa-podcast" aria-hidden="true"></i> The Big Blue Rock Pod</h1>
      <p class="text-gray-700 mt-2">
        Conversations about Kentucky geology from the Kentucky Geological Survey.
        Browse episodes by topic or search the show notes.
      </p>
    </div>

    {episodes.length === 0 ? (
      <p class="p-4 border border-gray-300 rounded bg-gray-50">
        Episodes aren't available right now. Please check back later.
      </p>
    ) : (
      <>
        <nav aria-labelledby="topic-filter-label" class="mb-6 rounded-lg border border-gray-200 bg-gray-50 p-4">
          <h2 id="topic-filter-label" class="text-sm font-semibold uppercase tracking-wide text-gray-700 mt-0 mb-3">
            Filter by topic
          </h2>
          <div class="flex flex-wrap gap-2">
            <a href="/podcast" aria-current={!activeTopic ? 'page' : undefined}
               class:list={[btnBase, !activeTopic ? btnOn : btnOff]}>
              {!activeTopic && <i class="fas fa-check" aria-hidden="true"></i>}
              All episodes
              <span class={!activeTopic ? badgeOn : badgeOff}>{episodes.length}</span>
            </a>
            {usedTopics.map(t => {
              const on = t.slug === activeSlug;
              return (
                <a href={`/podcast?topic=${t.slug}`} aria-current={on ? 'page' : undefined}
                   class:list={[btnBase, on ? btnOn : btnOff]}>
                  {on && <i class="fas fa-check" aria-hidden="true"></i>}
                  {t.name}
                  <span class={on ? badgeOn : badgeOff}>{counts.get(t.slug)}</span>
                </a>
              );
            })}
          </div>
        </nav>

        <div class="mb-6">
          <label for="episode-search" class="block font-semibold text-[#1B365D] mb-1">
            Search {activeTopic ? `${activeTopic.name} episodes` : 'episodes'}
          </label>
          <input id="episode-search" type="search" autocomplete="off"
                 class="w-full md:w-96 border border-gray-400 rounded px-3 py-2"
                 aria-describedby="episode-count" />
          <p id="episode-count" class="mt-2 text-sm text-gray-700" aria-live="polite">
            {shown.length} episode{shown.length === 1 ? '' : 's'}{activeTopic ? ` in ${activeTopic.name}` : ''}
          </p>
        </div>

        <div class="space-y-6">
          {shown.map(ep => (
            <article id={`episode-${ep.episode_number}`} data-episode
                data-search={`${ep.title} ${stripHtml(ep.description)} ${ep.topics.map(t => t.name).join(' ')}`.toLowerCase()}
                class="border border-gray-200 rounded-lg p-5 flex flex-col sm:flex-row gap-5">
              {/* Fallback chain: episode art → show logo → branded tile.
                  The tile always renders underneath; if the episode art fails, onerror swaps in
                  the show logo, and if that fails too the image is removed so the tile shows. */}
              <div class="relative w-28 h-28 shrink-0 rounded overflow-hidden bg-gradient-to-br from-[#0033A0] to-[#1B365D] flex items-center justify-center" aria-hidden="true">
                <i class="fas fa-podcast text-white/90 text-4xl"></i>
                <img src={ep.image_url || PODCAST_DEFAULT_IMAGE} alt="" loading="lazy" width="112" height="112"
                     data-fallback={PODCAST_DEFAULT_IMAGE}
                     onerror="if (this.dataset.fallback && this.src !== this.dataset.fallback) { this.src = this.dataset.fallback; } else { this.remove(); }"
                     class="absolute inset-0 w-full h-full object-cover" />
              </div>
              <div class="min-w-0 flex-1">
                <h2 class="text-xl font-semibold text-[#1B365D] mt-0">
                  {ep.title}
                </h2>
                <p class="text-sm text-gray-700 mt-1">
                  <time datetime={ep.pub_date}>{formatDate(ep.pub_date)}</time>
                  {ep.duration && <span>{` · ${formatDuration(ep.duration)}`}</span>}
                </p>

                {ep.topics.length > 0 && (
                  <div class="flex flex-wrap items-center gap-2 mt-2">
                    <span class="sr-only">Topics:</span>
                    {ep.topics.map(t => (
                      <a href={`/podcast?topic=${t.slug}`}
                         class="text-xs font-medium px-2.5 py-1 rounded-full border border-blue-200 bg-blue-50 text-[#0033A0] no-underline hover:border-[#0033A0]">
                        <i class="fas fa-tag mr-1" aria-hidden="true"></i>{t.name}
                      </a>
                    ))}
                  </div>
                )}

                <p class="mt-3 text-gray-800">{ep.summary}</p>

                {ep.audio_url && (
                  <audio controls preload="none" src={ep.audio_url} class="w-full mt-3"
                         aria-label={`Play ${ep.title}`}></audio>
                )}

                {ep.description && (
                  <details class="mt-3">
                    <summary class="cursor-pointer font-semibold text-[#0033A0]">Show notes</summary>
                    <div class="prose max-w-none mt-2" set:html={ep.description} />
                  </details>
                )}

                {ep.episode_url && (
                  <p class="mt-3 text-sm">
                    <a href={ep.episode_url} class="text-[#0033A0] underline">
                      <i class="fas fa-external-link-alt" aria-hidden="true"></i> Episode page on Podbean
                    </a>
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>

        <p id="no-results" class="text-gray-700" hidden>No episodes match your search.</p>
      </>
    )}
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const input = document.getElementById('episode-search');
    if (!input) return;
    const count = document.getElementById('episode-count');
    const empty = document.getElementById('no-results');
    const items = Array.from(document.querySelectorAll('[data-episode]'));
    const baseLabel = count.textContent;

    input.addEventListener('input', () => {
      const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      items.forEach(li => {
        const match = terms.every(t => li.dataset.search.includes(t));
        li.hidden = !match;
        if (match) visible++;
      });
      count.textContent = terms.length ? `${visible} of ${items.length} episodes match` : baseLabel;
      empty.hidden = visible > 0;
    });
  })();
</script>
