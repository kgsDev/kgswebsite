---
// src/pages/data/oilgas.astro
// Oil & Gas data downloads page
// Migrated from legacy Apache/PHP site + dynamic datasets from Directus (tag: 'oilgas')

export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import DatasetCard from '../../components/DatasetCard.astro';
import { fetchDatasets } from '../../lib/api_datalinks.js';

const title = 'Oil & Gas Datasets';
const description = 'Download Kentucky oil and gas well location shapefiles, other datasets, data services, and scanned resources related to Kentucky oil and gas from the Kentucky Geological Survey.';

// Fetch dynamic datasets tagged as oilgas from Directus
let dynamicDatasets = [];
try {
  dynamicDatasets = await fetchDatasets('oilgas');
} catch (e) {
  console.error('Could not load dynamic datasets:', e.message);
}

const OG_SEARCH = 'https://kgs.uky.edu/kygeode/services/oilgas/';
const OG_MAP    = 'https://kgs.uky.edu/kygeode/geomap/?LayoutID=2';

const tools = [
  {
    title: 'Oil & Gas Data Search (KY Geode)',
    desc: 'Search KGS oil and gas well records using predefined queries. Access well logs, scanned images, stratigraphic tops, and production data.',
    url: OG_SEARCH,
    icon: 'fa-oil-well',
  },
  {
    title: 'Oil & Gas Data on the KY Geologic Map Service',
    desc: 'Explore oil and gas well locations on the KY Geologic Map Information Service. View, query, and export data from the KGS well database.',
    url: OG_MAP,
    icon: 'fa-map-location-dot',
  },
  {
    title: 'Coordinate Conversion Tool',
    desc: 'Convert between Kentucky State Plane, Carter coordinate, and lat/lon systems.',
    url: 'https://kgs.uky.edu/kgsweb/CoordConversionTool.asp',
    icon: 'fa-compass',
  },
  {
    title: 'Gathering Line Map Tool',
    desc: 'Required by regulation: create gathering line maps for submission to the Kentucky Division of Oil and Gas.',
    url: 'https://kgs.uky.edu/kgsweb/DataSearching/OilGas/GatherLineSrch.asp',
    icon: 'fa-diagram-project',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  activePage="data"
  showBreadcrumb={true}
  customBreadcrumbs={[
    { label: 'Data & Downloads', href: '/data' },
    { label: 'Oil & Gas', isLast: true }
  ]}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </Fragment>

  <!-- Page Hero -->
  <div class="relative bg-gradient-to-br from-[#0033A0] via-[#1B365D] to-[#0033A0] mb-8 overflow-hidden">
    <div class="container mx-auto px-4 py-12 relative">
      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 flex items-center gap-4 drop-shadow-lg" style="color: var(--ivory)">
          <i class="fas fa-oil-well" aria-hidden="true"></i>
          Oil &amp; Gas Datasets
        </h1>
        <p class="text-xl mb-6 drop-shadow-lg" style="color: var(--ivory)">{description}</p>
        <div class="flex flex-wrap gap-3">
          <a href="/data/" class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 hover:bg-white/30 text-white rounded-lg transition-colors text-sm">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            All Data Downloads
          </a>
          <a href={OG_SEARCH} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 hover:bg-white/30 text-white rounded-lg transition-colors text-sm">
            <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            Oil &amp; Gas Data Search (KY Geode)
          </a>
          <a href={OG_MAP} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 hover:bg-white/30 text-white rounded-lg transition-colors text-sm">
            <i class="fas fa-map" aria-hidden="true"></i>
            Oil &amp; Gas Data on the KY Geologic Map Service
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto">

    <!-- Intro note -->
    <div class="bg-blue-50 border-l-4 border-[#0033A0] p-5 rounded-r-lg mb-8 text-gray-700 leading-relaxed">
      <p>
        The downloads below include GIS shapefiles, other datasets, mapping service endpoints (REST APIs), and scanned resources related to Kentucky oil and gas wells.
        The well location shapefile contains data for over 160,000 well locations and is updated monthly.
        Use these data with your own GIS software or cloud services such as
        <a href="https://www.arcgis.com/index.html" target="_blank" rel="noopener noreferrer" class="text-[#0033A0] hover:underline">ArcGIS Online</a>.
      </p>
    </div>

    <!-- ───────────────────────────────────────────
         DYNAMIC DATASETS FROM DIRECTUS
    ─────────────────────────────────────────── -->
    {dynamicDatasets.length > 0 ? (
      <section class="mb-12" aria-labelledby="downloads-heading">
        <h2 id="downloads-heading" class="text-2xl font-bold text-[#1B365D] mb-5 flex items-center gap-2">
          <i class="fas fa-download text-[#0033A0]" aria-hidden="true"></i>
          Downloads &amp; Data Services
        </h2>
        <div class="space-y-6">
          {dynamicDatasets.map(dataset => <DatasetCard dataset={dataset} />)}
        </div>
      </section>
    ) : (
      <div class="bg-white border border-gray-200 rounded-lg p-8 text-center text-gray-500 mb-12">
        <i class="fas fa-database text-3xl mb-3 block text-gray-300" aria-hidden="true"></i>
        No datasets are currently available. Please check back soon.
      </div>
    )}

    <!-- ───────────────────────────────────────────
         ONLINE SEARCH TOOLS
    ─────────────────────────────────────────── -->
    <section class="mb-12" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="text-2xl font-bold text-[#1B365D] mb-5 flex items-center gap-2">
        <i class="fas fa-magnifying-glass text-[#0033A0]" aria-hidden="true"></i>
        Online Search &amp; Query Tools
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {tools.map(tool => (
          <a
            href={tool.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-4 p-4 bg-white border border-gray-200 rounded-lg hover:border-[#0033A0] hover:shadow-md transition-all group"
          >
            <div class="shrink-0 w-10 h-10 rounded-full bg-blue-50 group-hover:bg-blue-100 flex items-center justify-center transition-colors">
              <i class={`fas ${tool.icon} text-[#0033A0]`} aria-hidden="true"></i>
            </div>
            <div>
              <p class="font-semibold text-[#1B365D] group-hover:text-[#0033A0] transition-colors mb-1">
                {tool.title} <i class="fas fa-arrow-up-right-from-square text-xs ml-1 opacity-60" aria-hidden="true"></i>
              </p>
              <p class="text-sm text-gray-600">{tool.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ───────────────────────────────────────────
         COPYRIGHT & CONTACT
    ─────────────────────────────────────────── -->
    <section class="mb-8">
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-5 text-sm text-gray-600 space-y-2">
        <p>
          <strong>Copyright:</strong> Data and images are copyrighted by the Kentucky Geological Survey, University of Kentucky.
          Users are granted the right to use these data to produce maps, charts, and reports, and to redistribute the shapefiles in their original form with this documentation included.
        </p>
        <p>
          <strong>Disclaimer:</strong> Data are presented as-is with no warranty, either expressed or implied, as to the completeness or accuracy of any location or well status.
          Data are submitted by well operators under requirements of
          <a href="https://apps.legislature.ky.gov/law/statutes/chapter.aspx?id=38944" target="_blank" rel="noopener noreferrer" class="text-[#0033A0] hover:underline">Kentucky Revised Statute 353</a>.
        </p>
        <p>
          <strong>Questions?</strong> Contact <a href="mailto:carrie.p@uky.edu" class="text-[#0033A0] hover:underline">Carrie Pulliam</a> — 859-323-0543
        </p>
      </div>
    </section>

  </div>
</BaseLayout>