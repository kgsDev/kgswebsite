---
// src/layouts/NewsLayout.astro
import BaseLayout from './BaseLayout.astro';
import { fetchNewsYears } from '../lib/api_news';

// Get list of available years for archive links
const years = await fetchNewsYears();

// Get current path for active link highlighting
const pathname = Astro.url.pathname;

// Define props with defaults specific to news pages
const { 
  title = 'News & Announcements',
  description = 'Latest news, updates, and events from the Kentucky Geological Survey.',
  showBreadcrumb = true,
  customBreadcrumbs = null, // Allow custom breadcrumbs to be passed through
} = Astro.props;
---

<BaseLayout 
  title={title}
  description={description}
  activePage="news"
  showBreadcrumb={showBreadcrumb}
  customBreadcrumbs={customBreadcrumbs}
>
  <!-- Only add manual breadcrumb if we need to override the automatic ones -->
  <slot name="breadcrumb" slot="breadcrumb" />
  
  <!-- Pass head content if needed -->
  <Fragment slot="head">
    <slot name="head-meta" />
  </Fragment>
  
  <!-- Main news content -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Sidebar for news categories, archives, etc. -->
    <aside class="md:col-span-1 order-2 md:order-1">
      <slot name="sidebar">
        <!-- Default sidebar content -->
        <div class="bg-white p-4 rounded-lg shadow mb-6">
          <h2 class="text-xl font-bold mb-4 text-blue-800">News Categories</h2>
          <ul class="space-y-2">
            <li>
              <a 
                href="/news" 
                class={`baselink ${pathname === '/news/' || pathname === '/news' ? 'font-bold' : 'hover:underline'}`}
              >
                All News
              </a>
            </li>
            <li>
              <a 
                href="/news/press-releases" 
                class={`baselink ${pathname.includes('/news/press-releases') ? 'font-bold' : 'hover:underline'}`}
              >
                Press Releases
              </a>
            </li>
            <li>
              <a 
                href="/news/research" 
                class={`baselink ${pathname.includes('/news/research') ? 'font-bold' : 'hover:underline'}`}
              >
                Research Updates
              </a>
            </li>
            <li>
              <a 
                href="/news/collection" 
                class={`baselink ${pathname.includes('/news/collection') ? 'font-bold' : 'hover:underline'}`}
              >
                From Our Collection
              </a>
            </li>            
            <li>
              <a 
                href="/news/media" 
                class={`baselink ${pathname.includes('/news/media') ? 'font-bold' : 'hover:underline'}`}
              >
                KGS in the Media
              </a>
            </li>
            <li>
              <a 
                href="/news/events" 
                class={`baselink ${pathname.includes('/news/events') ? 'font-bold' : 'hover:underline'}`}
              >
                Events
              </a>
            </li>
          </ul>
        </div>
        
        {years.length > 0 && (
          <div class="bg-white p-4 rounded-lg shadow">
            <h2 class="text-xl font-bold mb-4">Archives</h2>
            <ul class="space-y-2">
              {years.map(year => (
                <li>
                  <a 
                    href={`/news/archive/${year}`} 
                    class={`baselink ${pathname.includes(`/news/archive/${year}`) ? 'font-bold' : 'hover:underline'}`}
                  >
                    {year}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- RSS Feed Link -->
        <div class="bg-white p-4 rounded-lg shadow mt-6">
          <a href="/rss.xml" class="flex items-center gap-2 text-orange-500 hover:text-orange-600 font-medium">
            <i class="fa-solid fa-square-rss text-xl"></i>
            Subscribe via RSS
          </a>
        </div>
      </slot>
    </aside>
    
    <!-- Main news content area -->
    <div class="md:col-span-2 order-1 md:order-2">
      <slot />
    </div>
  </div>
</BaseLayout>